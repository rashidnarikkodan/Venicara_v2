{
  "name": "venicara",
  "version": "1.0.0",
  "private": true,
  "description": "Venicara backend API for e-commerce platform, handling user authentication, product management, orders, referrals, and admin operations.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "method-override": "^3.0.0",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nocache": "^4.0.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.2",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19"
  }
}
