<%- include('../partials/admin/header.ejs') %>

<div class="space-y-8 animate-fade-in">
  
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Customer Relations</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Manage your luxury fragrance clientele</p>
    </div>
    
    <div class="flex items-center space-x-4">
      <div class="relative group">
        <form action="/admin/customers" method="GET" class="flex items-center">
          <i class="fa-solid fa-magnifying-glass absolute left-4 text-gray-400 group-focus-within:text-gold-500 transition-colors"></i>
          <input 
            type="text" 
            name="search" 
            placeholder="Search by name/email..." 
            value="<%= search %>"
            class="pl-11 pr-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm min-w-[300px] dark:text-white shadow-sm"
          >
        </form>
      </div>
    </div>
  </div>

  <!-- Customers Table -->
  <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-100 dark:border-white/5">
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">No.</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Client Profile</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Access Key</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Verification</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Joined</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-white/5">
          <% users.forEach((user, idx) => { %>
            <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="px-8 py-6 text-xs font-mono font-bold text-gray-400"><%= idx + 1 + (currentPage - 1) * limit %></td>
              <td class="px-8 py-6">
                <div class="flex items-center space-x-4">
                  <div class="w-10 h-10 bg-luxury-black dark:bg-gold-500/10 rounded-full flex items-center justify-center text-white dark:text-gold-500 font-bold text-xs uppercase">
                    <%= user.name.slice(0, 2) %>
                  </div>
                  <div>
                    <p class="text-sm font-bold dark:text-white leading-tight"><%= user.name %></p>
                    <p class="text-[10px] text-gray-400 font-bold lowercase tracking-widest mt-0.5"><%= user.email %></p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="text-xs font-mono text-gray-500 dark:text-gray-400">ID_<%= user.userId %></span>
              </td>
              <td class="px-8 py-6">
                <div class="flex items-center space-x-2">
                  <span class="w-2 h-2 rounded-full <%= user.isVerified ? 'bg-green-500' : 'bg-red-500' %>"></span>
                  <span class="text-[10px] font-bold uppercase tracking-widest <%= user.isVerified ? 'text-green-600' : 'text-red-500' %>">
                    <%= user.isVerified ? 'Verified' : 'Unverified' %>
                  </span>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="text-xs font-bold dark:text-gray-300"><%= user.createdAt.toLocaleDateString() %></span>
              </td>
              <td class="px-8 py-6 text-right">
                <button 
                  onclick="showConfirmModal('<%=user._id%>', '<%= user.isBlocked ? 'Access will be restored for ' + user.name : 'Customer access will be revoked for ' + user.name %>')"
                  class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl transition-all border <%= user.isBlocked ? 'bg-red-50 dark:bg-red-500/10 text-red-600 border-red-100 dark:border-red-500/20' : 'bg-green-50 dark:bg-green-500/10 text-green-600 border-green-100 dark:border-green-500/20' %>"
                >
                  <i class="fa-solid <%= user.isBlocked ? 'fa-user-slash' : 'fa-user-check' %> text-xs"></i>
                  <span class="text-[10px] font-bold uppercase tracking-widest"><%= user.isBlocked ? 'Blocked' : 'Active' %></span>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-8 py-6 bg-gray-50/50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        Total Clients: <%= users.length %>
      </p>
      
      <div class="flex items-center space-x-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>
        <% } %>
        
        <div class="px-4 py-2 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-xs font-bold dark:text-white">
          <%= currentPage %>
        </div>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="confirmModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-luxury-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-luxury-charcoal w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
      <div class="p-10 text-center">
        <div class="w-20 h-20 bg-gold-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fa-solid fa-user-gear text-3xl text-gold-600 dark:text-gold-400"></i>
        </div>
        <h3 class="text-xl font-serif font-bold dark:text-white mb-2">Access Control</h3>
        <p id="confirmMessage" class="text-sm text-gray-500 dark:text-gray-400 font-medium px-4"></p>
        
        <div class="grid grid-cols-2 gap-4 mt-10">
          <button onclick="closeModal()" class="py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-luxury-black transition-all">
            Dismiss
          </button>
          <button id="confirmActionBtn" class="py-4 rounded-2xl bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg shadow-gold-500/20">
            Apply Change
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let targetUserId = null;

  function showConfirmModal(userId, message) {
    targetUserId = userId;
    document.getElementById('confirmMessage').textContent = message;
    document.getElementById('confirmModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  document.getElementById('confirmActionBtn').addEventListener('click', () => {
    if (targetUserId) {
      toggleUserStatus(targetUserId);
    }
  });

  async function toggleUserStatus(userId) {
    try {
      const res = await fetch(`/admin/customers/${userId}/toggle?_method=PATCH`, {
        method: 'PATCH'
      });
      if (res.ok) {
        location.reload();
      } else {
        new Notyf().error('Failed to update client status');
      }
    } catch (err) {
      new Notyf().error('Network synchronization error');
    }
  }
</script>

<%- include('../partials/admin/footer.ejs') %>