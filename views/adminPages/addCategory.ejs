<%- include('../partials/admin/header.ejs') %>

<div class="max-w-4xl mx-auto animate-fade-in">
  
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-10">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Create New Category</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Define a new fragrance lineage</p>
    </div>
    <a href="/admin/categories" class="p-3 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-600 transition-colors">
      <i class="fa-solid fa-xmark text-lg"></i>
    </a>
  </div>

  <form id="addCategoryForm" method="post" action="/admin/categories/add" class="space-y-8">
    
    <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Category Name</label>
          <input type="text" name="name" required placeholder="eg: Woody, Oriental, Fresh" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Active Discount (%)</label>
          <input type="number" name="discount" placeholder="eg: 15" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
        </div>
      </div>

      <div>
        <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Category Description</label>
        <textarea name="description" rows="8" placeholder="Describe the characteristics and target audience of this category..." class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white resize-none"></textarea>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end space-x-4 pt-6">
      <a href="/admin/categories" class="px-8 py-4 rounded-2xl bg-white dark:bg-luxury-charcoal text-[10px] font-bold uppercase tracking-widest text-gray-500 border border-gray-100 dark:border-white/5 hover:bg-gray-50 transition-all">
        Discard
      </a>
      <button type="submit" class="px-12 py-4 rounded-2xl bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-xl shadow-gold-500/20">
        Create Category
      </button>
    </div>

  </form>
</div>

<%- include('../partials/admin/footer.ejs') %>