<%- include('../partials/admin/header.ejs') %>

<div class="space-y-8 animate-fade-in">
  
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Product Inventory</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Manage your perfume collection and stock</p>
    </div>
    
    <div class="flex items-center space-x-4">
      <div class="relative group">
        <form action="/admin/products" method="GET" class="flex items-center">
          <i class="fa-solid fa-magnifying-glass absolute left-4 text-gray-400 group-focus-within:text-gold-500 transition-colors"></i>
          <input 
            type="text" 
            name="search" 
            placeholder="Search products..." 
            value="<%= search %>"
            class="pl-11 pr-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm min-w-[300px] dark:text-white shadow-sm"
          >
        </form>
      </div>
      <a href="/admin/products/add" class="bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-8 py-3.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg shadow-gold-500/10 flex items-center">
        <i class="fa-solid fa-plus mr-2"></i> Add New
      </a>
    </div>
  </div>

  <!-- Products Table Container -->
  <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-100 dark:border-white/5">
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">ID</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Product</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Category</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Stock</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Price</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Status</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-white/5">
          <% products.forEach(product => { %>
            <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="px-8 py-6">
                <span class="text-xs font-mono font-bold text-gray-400 group-hover:text-gold-600 transition-colors">#<%= String(product._id).slice(-6).toUpperCase() %></span>
              </td>
              <td class="px-8 py-6">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-14 rounded-2xl overflow-hidden bg-gray-100 dark:bg-luxury-black border border-gray-100 dark:border-white/5 shadow-sm">
                    <img src="<%= product.image?.url %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                  </div>
                  <div>
                    <p class="text-sm font-bold dark:text-white leading-tight"><%= product.name %></p>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1"><%= product.variantLabel %></p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="px-3 py-1 bg-gold-500/10 text-gold-600 dark:text-gold-400 text-[10px] font-bold uppercase tracking-widest rounded-lg">
                  <%= product.categoryName %>
                </span>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-sm font-bold dark:text-gray-200"><%= product.totalStock %></span>
                  <div class="w-16 h-1 bg-gray-100 dark:bg-luxury-black rounded-full mt-2 overflow-hidden">
                    <div class="h-full bg-gold-500 rounded-full" style="width: <%= Math.min(product.totalStock, 100) %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="text-sm font-bold dark:text-white">₹<%= product.basePrice %></span>
              </td>
              <td class="px-8 py-6">
                <button 
                  onclick="showConfirmModal('toggle','<%=product._id%>','Are you sure you want to change the status of this product?')"
                  class="flex items-center space-x-2 px-3 py-1.5 rounded-xl transition-all <%= product.isAvailable ? 'bg-green-500/10 text-green-600' : 'bg-red-500/10 text-red-600' %>"
                >
                  <span class="w-1.5 h-1.5 rounded-full <%= product.isAvailable ? 'bg-green-500 animate-pulse' : 'bg-red-500' %>"></span>
                  <span class="text-[10px] font-bold uppercase tracking-widest"><%= product.isAvailable ? 'Live' : 'Hidden' %></span>
                </button>
              </td>
              <td class="px-8 py-6">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/admin/products/edit/<%=product._id%>" class="w-9 h-9 flex items-center justify-center rounded-xl bg-gray-50 dark:bg-luxury-black text-gray-400 hover:text-gold-600 dark:hover:text-gold-400 transition-colors border border-gray-100 dark:border-white/5">
                    <i class="fa-solid fa-pen-to-square text-sm"></i>
                  </a>
                  <button onclick="showConfirmModal('delete','<%=product._id%>','Permanently delete this product? This action cannot be undone.')" class="w-9 h-9 flex items-center justify-center rounded-xl bg-gray-50 dark:bg-luxury-black text-gray-400 hover:text-red-500 transition-colors border border-gray-100 dark:border-white/5">
                    <i class="fa-solid fa-trash-can text-sm"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    
    <!-- Table Footer / Pagination -->
    <div class="px-8 py-6 bg-gray-50/50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        Showing Page <%= currentPage %> of <%= totalPages %>
      </p>
      
      <div class="flex items-center space-x-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>
        <% } %>
        
        <div class="px-4 py-2 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-xs font-bold dark:text-white">
          <%= currentPage %>
        </div>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Custom Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-luxury-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-luxury-charcoal w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
      <div class="p-10 text-center">
        <div class="w-20 h-20 bg-gold-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fa-solid fa-circle-question text-3xl text-gold-600 dark:text-gold-400"></i>
        </div>
        <h3 class="text-xl font-serif font-bold dark:text-white mb-2">Are you sure?</h3>
        <p id="confirmMessage" class="text-sm text-gray-500 dark:text-gray-400 font-medium"></p>
        
        <div class="grid grid-cols-2 gap-4 mt-10">
          <button onclick="closeModal()" class="py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-luxury-black transition-all">
            Cancel
          </button>
          <button id="confirmActionBtn" class="py-4 rounded-2xl bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg shadow-gold-500/20">
            Proceed
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden delete form -->
<form id="deleteForm" method="POST" class="hidden">
  <input type="hidden" name="_method" value="DELETE">
</form>

<script>
  let currentProductId = null;
  let currentOperation = null;

  function showConfirmModal(operation, productId, message) {
    currentProductId = productId;
    currentOperation = operation;
    document.getElementById('confirmMessage').textContent = message;
    document.getElementById('confirmModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  document.getElementById('confirmActionBtn').addEventListener('click', () => {
    if (currentOperation === 'delete') {
      const form = document.getElementById('deleteForm');
      form.action = `/admin/products/${currentProductId}?_method=DELETE`;
      form.submit();
    } else if (currentOperation === 'toggle') {
      toggleProductActive(currentProductId);
    }
  });

  function toggleProductActive(productId) {
    fetch(`/admin/products/${productId}/toggle?_method=PATCH`, {
      method: 'PATCH'
    })
    .then(response => {
      if (response.ok) {
        location.reload();
      } else {
        new Notyf().error('Failed to update product status');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      new Notyf().error('An unexpected error occurred');
    });
  }
</script>

<%- include('../partials/admin/footer.ejs') %>