<%- include('../partials/admin/header.ejs') %>

<div class="space-y-8 animate-fade-in">
  
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Promotion Engine</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Manage luxury fragrance discount protocols</p>
    </div>
    
    <div class="flex items-center space-x-4">
      <div class="relative group">
        <form action="/admin/coupons" method="GET" class="flex items-center">
          <i class="fa-solid fa-magnifying-glass absolute left-4 text-gray-400 group-focus-within:text-gold-500 transition-colors"></i>
          <input 
            type="text" 
            name="search" 
            placeholder="Search by code/name..." 
            value="<%= search %>"
            class="pl-11 pr-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm min-w-[250px] dark:text-white shadow-sm"
          >
        </form>
      </div>
      <button onclick="openModal('addCouponModal')" class="bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-8 py-3.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg shadow-gold-500/10 flex items-center">
        <i class="fa-solid fa-plus mr-2"></i> New Voucher
      </button>
    </div>
  </div>

  <!-- Coupons Table -->
  <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-100 dark:border-white/5">
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">No.</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Identity</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Discount</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Thresholds</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Validity</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Usage</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-white/5">
          <% coupons.forEach((coupon, idx) => { %>
            <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="px-8 py-6 text-xs font-mono font-bold text-gray-400"><%= idx + 1 + (currentPage - 1) * limit %></td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-sm font-bold dark:text-white uppercase tracking-wider"><%= coupon.name %></span>
                  <span class="text-[10px] font-mono font-bold text-gold-600 dark:text-gold-400 mt-1"><%= coupon.code %></span>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-green-500/10 text-green-600 uppercase tracking-widest">
                  <%= coupon.discount %>% OFF
                </span>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col space-y-1">
                  <div class="flex items-center text-[10px] font-bold uppercase tracking-widest text-gray-400">
                    <span class="w-8">MIN:</span>
                    <span class="dark:text-gray-300">₹<%= coupon.minPrice %></span>
                  </div>
                  <div class="flex items-center text-[10px] font-bold uppercase tracking-widest text-gray-400">
                    <span class="w-8">MAX:</span>
                    <span class="dark:text-gray-300">₹<%= coupon.maxDiscountAmount %></span>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-xs font-bold dark:text-gray-300"><%= coupon.expireAt.toLocaleDateString() %></span>
                  <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Expires On</span>
                </div>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col space-y-2">
                  <div class="flex justify-between text-[10px] font-bold uppercase tracking-widest text-gray-400">
                    <span>Redeemed</span>
                    <span><%= coupon.used %> / <%= coupon.limit %></span>
                  </div>
                  <div class="w-24 h-1 bg-gray-100 dark:bg-luxury-black rounded-full overflow-hidden">
                    <div class="h-full bg-gold-500 rounded-full" style="width: <%= (coupon.used / coupon.limit) * 100 %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6 text-right">
                <form action="/admin/coupons/<%=coupon._id%>?_method=PATCH" method="POST" class="inline">
                  <button type="submit" onclick="return confirm('Terminate this voucher protocol?')" class="w-9 h-9 flex items-center justify-center rounded-xl bg-gray-50 dark:bg-luxury-black text-gray-400 hover:text-red-500 transition-colors border border-gray-100 dark:border-white/5 shadow-sm">
                    <i class="fa-solid fa-trash-can text-sm"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-8 py-6 bg-gray-50/50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        Active Vouchers: <%= coupons.length %>
      </p>
      
      <div class="flex items-center space-x-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>
        <% } %>
        
        <div class="px-4 py-2 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-xs font-bold dark:text-white">
          <%= currentPage %>
        </div>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div id="addCouponModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-luxury-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-luxury-charcoal w-full max-w-2xl rounded-[3rem] shadow-2xl overflow-hidden animate-zoom-in">
      <form id="couponForm" action="/admin/coupons/add" method="POST" class="p-10">
        <div class="flex items-center justify-between mb-10">
          <div>
            <h3 class="text-2xl font-serif font-bold dark:text-white">New Voucher Protocol</h3>
            <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mt-1">Configure promotion parameters</p>
          </div>
          <button type="button" onclick="closeModal('addCouponModal')" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-gray-50 dark:hover:bg-luxury-black transition-colors">
            <i class="fa-solid fa-xmark text-gray-400"></i>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Voucher Name</label>
            <input type="text" id="couponName" name="name" placeholder="eg: Summer Mist" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="nameError"></p>
          </div>
          
          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Access Code</label>
            <input type="text" id="couponCode" name="code" placeholder="eg: MIST30" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white uppercase">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="codeError"></p>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Min. Threshold (₹)</label>
            <input type="number" id="minPrice" name="minPrice" placeholder="500" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="minPriceError"></p>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Max Savings (₹)</label>
            <input type="number" id="maxDiscountAmount" name="maxDiscountAmount" placeholder="2000" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="maxDiscountError"></p>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Discount (%)</label>
            <input type="number" id="discount" name="discount" placeholder="15" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="discountError"></p>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Usage Limit</label>
            <input type="number" id="limit" name="limit" placeholder="100" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="limitError"></p>
          </div>

          <div class="md:col-span-2 space-y-1">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Protocol Expiration</label>
            <input type="date" id="expireAt" name="expireAt" class="w-full px-5 py-3.5 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
            <p class="text-[10px] text-red-500 font-bold uppercase mt-1 ml-1" id="expireError"></p>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-4 mt-12">
          <button type="button" onclick="closeModal('addCouponModal')" class="px-8 py-4 rounded-2xl bg-gray-100 dark:bg-luxury-black text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-luxury-black transition-all">Cancel</button>
          <button type="submit" class="px-12 py-4 bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black rounded-2xl text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-xl shadow-gold-500/20">Generate Protocol</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  document.getElementById('couponForm').addEventListener('submit', function (e) {
    e.preventDefault();
    let hasError = false;

    const fields = {
      name: { el: document.getElementById('couponName'), err: document.getElementById('nameError') },
      code: { el: document.getElementById('couponCode'), err: document.getElementById('codeError') },
      minPrice: { el: document.getElementById('minPrice'), err: document.getElementById('minPriceError') },
      discount: { el: document.getElementById('discount'), err: document.getElementById('discountError') },
      maxDiscount: { el: document.getElementById('maxDiscountAmount'), err: document.getElementById('maxDiscountError') },
      limit: { el: document.getElementById('limit'), err: document.getElementById('limitError') },
      expire: { el: document.getElementById('expireAt'), err: document.getElementById('expireError') }
    };

    Object.values(fields).forEach(f => f.err.textContent = '');

    if (fields.name.el.value.trim().length < 3) {
      fields.name.err.textContent = 'Name too short';
      hasError = true;
    }
    if (!/^[A-Z0-9]+$/i.test(fields.code.el.value.trim())) {
      fields.code.err.textContent = 'Invalid characters';
      hasError = true;
    }
    if (Number(fields.minPrice.el.value) <= 0) {
      fields.minPrice.err.textContent = 'Must be > 0';
      hasError = true;
    }
    if (Number(fields.discount.el.value) <= 0 || Number(fields.discount.el.value) > 100) {
      fields.discount.err.textContent = '1-100 range';
      hasError = true;
    }
    if (!fields.expire.el.value || new Date(fields.expire.el.value) <= new Date()) {
      fields.expire.err.textContent = 'Future date required';
      hasError = true;
    }

    if (!hasError) e.target.submit();
  });
</script>

<%- include('../partials/admin/footer.ejs') %>
