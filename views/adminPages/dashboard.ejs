<%- include('../partials/admin/header.ejs') %>

<div class="space-y-10 animate-fade-in">
  
  <!-- KPI Overview -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Total Revenue -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all duration-300">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gold-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-indian-rupee-sign text-gold-600 dark:text-gold-400 text-xl"></i>
        </div>
        <span class="text-[10px] font-bold text-green-500 bg-green-500/10 px-2 py-1 rounded-full">+12.5%</span>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">Total Revenue</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight">₹<%= dashboardData.totalSales %></h3>
    </div>

    <!-- Total Orders -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all duration-300">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-blue-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-bag-shopping text-blue-600 dark:text-blue-400 text-xl"></i>
        </div>
        <span class="text-[10px] font-bold text-blue-500 bg-blue-500/10 px-2 py-1 rounded-full">Active</span>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">Total Orders</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight"><%= dashboardData.totalOrders %></h3>
    </div>

    <!-- Products Sold -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all duration-300">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-green-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-boxes-stacked text-green-600 dark:text-green-400 text-xl"></i>
        </div>
        <span class="text-[10px] font-bold text-green-500 bg-green-500/10 px-2 py-1 rounded-full">Stocked</span>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">Products Sold</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight"><%= dashboardData.productsSold %></h3>
    </div>

    <!-- New Customers -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all duration-300">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-purple-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-people-group text-purple-600 dark:text-purple-400 text-xl"></i>
        </div>
        <span class="text-[10px] font-bold text-purple-500 bg-purple-500/10 px-2 py-1 rounded-full">Growing</span>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">New Customers</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight"><%= dashboardData.newCustomers %></h3>
    </div>
  </div>

  <!-- Analytics Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    
    <!-- Charts Container -->
    <div class="lg:col-span-2 space-y-10">
      <!-- Revenue Trends -->
      <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h4 class="text-lg font-serif font-bold dark:text-white">Revenue Performance</h4>
            <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">Historical data analytics</p>
          </div>
          <div class="flex bg-gray-100 dark:bg-luxury-black p-1 rounded-xl">
            <a href="?filter=daily" class="px-4 py-2 text-[10px] font-bold uppercase tracking-widest rounded-lg transition-all <%= filter==='daily' ? 'bg-white dark:bg-luxury-charcoal shadow-sm text-gold-600' : 'text-gray-400 hover:text-gray-600' %>">Daily</a>
            <a href="?filter=weekly" class="px-4 py-2 text-[10px] font-bold uppercase tracking-widest rounded-lg transition-all <%= filter==='weekly' ? 'bg-white dark:bg-luxury-charcoal shadow-sm text-gold-600' : 'text-gray-400 hover:text-gray-600' %>">Weekly</a>
            <a href="?filter=monthly" class="px-4 py-2 text-[10px] font-bold uppercase tracking-widest rounded-lg transition-all <%= filter==='monthly' ? 'bg-white dark:bg-luxury-charcoal shadow-sm text-gold-600' : 'text-gray-400 hover:text-gray-600' %>">Monthly</a>
            <a href="?filter=yearly" class="px-4 py-2 text-[10px] font-bold uppercase tracking-widest rounded-lg transition-all <%= filter==='yearly' ? 'bg-white dark:bg-luxury-charcoal shadow-sm text-gold-600' : 'text-gray-400 hover:text-gray-600' %>">Yearly</a>
          </div>
        </div>
        <div class="h-80 w-full">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>

      <!-- Inventory & Sales Trends -->
      <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5">
        <div class="mb-8">
          <h4 class="text-lg font-serif font-bold dark:text-white">Sales & Fulfillment</h4>
          <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">Products sold vs returns vs cancellations</p>
        </div>
        <div class="h-80 w-full">
          <canvas id="productSoldChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Top Products Sidebar -->
    <div class="space-y-6">
      <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 h-full">
        <h4 class="text-lg font-serif font-bold dark:text-white mb-8">Bestsellers</h4>
        
        <div class="space-y-6">
          <% dashboardData.topProducts.forEach((product, idx) => { %>
            <div class="flex items-center space-x-4 group cursor-pointer">
              <div class="relative">
                <img src="<%= product.img[0]?.url %>" alt="<%= product.name %>" class="w-14 h-14 rounded-2xl object-cover shadow-md group-hover:scale-105 transition-transform">
                <span class="absolute -top-2 -right-2 w-6 h-6 bg-gold-500 text-luxury-black text-[10px] font-bold flex items-center justify-center rounded-lg shadow-lg border-2 border-white dark:border-luxury-charcoal">
                  #<%= idx + 1 %>
                </span>
              </div>
              <div class="flex-1 overflow-hidden">
                <p class="text-sm font-bold dark:text-gray-200 truncate leading-tight"><%= product.name %></p>
                <p class="text-[10px] text-gold-600 dark:text-gold-400 font-bold uppercase tracking-widest mt-1"><%= product.totalSold %> Units Sold</p>
              </div>
              <div class="text-right">
                <i class="fa-solid fa-chevron-right text-[10px] text-gray-300 group-hover:text-gold-500 transition-colors"></i>
              </div>
            </div>
          <% }) %>
        </div>

        <a href="/admin/products" class="mt-10 block w-full text-center py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-gold-600 transition-colors border border-dashed border-gray-200 dark:border-white/5">
          View Detailed Inventory
        </a>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Common Chart Config
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.color = document.documentElement.classList.contains('dark') ? '#9ca3af' : '#6b7280';
  
  const isDark = document.documentElement.classList.contains('dark');
  const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

  // Products Sold Chart
  new Chart(document.getElementById("productSoldChart"), {
    type: "line",
    data: {
      labels: <%- JSON.stringify(dashboardData.productsSoldLabels) %>,
      datasets: [{
        label: "Sold",
        data: <%- JSON.stringify(dashboardData.productsSoldData) %>,
        borderColor: "#d4af37",
        backgroundColor: "rgba(212, 175, 55, 0.1)",
        tension: 0.4,
        fill: true,
        pointRadius: 4,
        pointBackgroundColor: "#d4af37"
      },{
        label: "Returned",
        data: <%- JSON.stringify(dashboardData.productsReturnedData) %>,
        borderColor: "#ef4444",
        backgroundColor: "rgba(239, 68, 68, 0.05)",
        tension: 0.4,
        fill: true,
        pointRadius: 0
      }]
    },
    options: { 
      maintainAspectRatio: false, 
      responsive: true,
      plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 6, font: { size: 10, weight: 'bold' } } } },
      scales: {
        y: { grid: { color: gridColor }, ticks: { font: { size: 10 } } },
        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
      }
    }
  });

  // Revenue Chart
  new Chart(document.getElementById("revenueChart"), {
    type: "bar",
    data: {
      labels: <%- JSON.stringify(dashboardData.revenueLabels) %>,
      datasets: [{
        label: "Revenue",
        data: <%- JSON.stringify(dashboardData.revenueChartData) %>,
        backgroundColor: "#d4af37",
        borderRadius: 8,
        barThickness: 20
      }]
    },
    options: { 
      maintainAspectRatio: false, 
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { grid: { color: gridColor }, ticks: { font: { size: 10 } } },
        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
      }
    }
  });
</script>

<%- include('../partials/admin/footer.ejs') %>
