<%- include('../partials/admin/header.ejs') %>

<div class="space-y-8 animate-fade-in">
  
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Order Management</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Track and fulfill luxury fragrance orders</p>
    </div>
  </div>

  <!-- Filters & Search Section -->
  <div class="bg-white dark:bg-luxury-charcoal p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5">
    <form action="/admin/orders" method="GET" class="flex flex-wrap gap-4 items-center">
      <!-- Search -->
      <div class="relative flex-grow min-w-[250px]">
        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input 
          type="text" 
          name="search" 
          placeholder="Order ID / Email..." 
          value="<%= search %>"
          class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white"
        >
      </div>

      <!-- Status Filter -->
      <div class="relative min-w-[160px]">
        <select name="status" class="w-full pl-4 pr-10 py-3 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white appearance-none">
          <option value="">All Status</option>
          <option value="pending" <%= status==='pending' ? 'selected' : '' %>>Pending</option>
          <option value="shipped" <%= status==='shipped' ? 'selected' : '' %>>Shipped</option>
          <option value="Out of delivery" <%= status==='Out of delivery' ? 'selected' : '' %>>Out of Delivery</option>
          <option value="delivered" <%= status==='delivered' ? 'selected' : '' %>>Delivered</option>
          <option value="cancelled" <%= status==='cancelled' ? 'selected' : '' %>>Cancelled</option>
          <option value="returned" <%= status==='returned' ? 'selected' : '' %>>Returned</option>
        </select>
        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
      </div>

      <!-- Sort -->
      <div class="relative min-w-[160px]">
        <select name="sort" class="w-full pl-4 pr-10 py-3 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white appearance-none">
          <option value="">Sort By</option>
          <option value="date_desc" <%= sort==='date_desc' ? 'selected' : '' %>>Date (Newest)</option>
          <option value="date_asc" <%= sort==='date_asc' ? 'selected' : '' %>>Date (Oldest)</option>
          <option value="amount_desc" <%= sort==='amount_desc' ? 'selected' : '' %>>Amount (High → Low)</option>
          <option value="amount_asc" <%= sort==='amount_asc' ? 'selected' : '' %>>Amount (Low → High)</option>
        </select>
        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
      </div>

      <div class="flex items-center space-x-2">
        <button type="submit" class="bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-6 py-3 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg shadow-gold-500/10">
          Apply
        </button>
        <a href="/admin/orders" class="p-3 bg-white dark:bg-luxury-black rounded-2xl border border-gray-100 dark:border-white/5 text-gray-400 hover:text-gold-600 transition-colors">
          <i class="fa-solid fa-rotate-left"></i>
        </a>
      </div>
    </form>
  </div>

  <!-- Orders Table -->
  <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-100 dark:border-white/5">
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">No.</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Order ID</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Customer</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Amount</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Date</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">Status</th>
            <th class="px-8 py-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-white/5">
          <% orders.forEach((order, idx) => { %>
            <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="px-8 py-6 text-xs font-mono font-bold text-gray-400">
                <%= idx + 1 + (currentPage - 1) * limit %>
              </td>
              <td class="px-8 py-6">
                <span class="text-xs font-bold text-luxury-black dark:text-gray-300">#<%= order.orderId %></span>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-sm font-bold dark:text-white truncate max-w-[150px]"><%= order.userId?.email %></span>
                  <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Verified User</span>
                </div>
              </td>
              <td class="px-8 py-6">
                <span class="text-sm font-bold dark:text-white">₹<%= order.finalAmount %></span>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-xs font-bold dark:text-gray-300"><%= order.createdAt?.toLocaleDateString() %></span>
                  <span class="text-[10px] text-gray-400 font-medium">Purchased On</span>
                </div>
              </td>
              <td class="px-8 py-6">
                <% 
                  let statusClass = 'bg-gray-500/10 text-gray-500';
                  if(order.status === 'delivered') statusClass = 'bg-green-500/10 text-green-600';
                  if(order.status === 'pending') statusClass = 'bg-gold-500/10 text-gold-600';
                  if(order.status === 'cancelled' || order.status === 'returned') statusClass = 'bg-red-500/10 text-red-600';
                  if(order.status === 'shipped') statusClass = 'bg-blue-500/10 text-blue-600';
                %>
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full <%= statusClass %> relative">
                  <span class="text-[10px] font-bold uppercase tracking-widest"><%= order.status %></span>
                  <% if(order.return.isRequested && !order.products.some(p => p.return.isRequested)) { %>
                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full animate-ping"></span>
                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full"></span>
                  <% } %>
                </div>
              </td>
              <td class="px-8 py-6 text-right">
                <a href="/admin/order/<%=order._id%>" class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest hover:scale-105 transition-transform shadow-md">
                  <span>Manage</span>
                  <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-8 py-6 bg-gray-50/50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        Showing Page <%= currentPage %> of <%= totalPages %>
      </p>
      
      <div class="flex items-center space-x-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>
        <% } %>
        
        <div class="px-4 py-2 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-xs font-bold dark:text-white">
          <%= currentPage %>
        </div>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin/footer.ejs') %>