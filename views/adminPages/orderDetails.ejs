<%- include('../partials/admin/header.ejs') %>

<div class="space-y-10 animate-fade-in pb-20">
  
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-10">
    <div>
      <div class="flex items-center space-x-3 mb-2">
        <a href="/admin/orders" class="text-gray-400 hover:text-gold-500 transition-colors">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="text-3xl font-serif font-bold dark:text-white">Order Analysis</h1>
      </div>
      <p class="text-[10px] text-gray-500 dark:text-gray-400 font-bold uppercase tracking-widest ml-7">Reference ID: #<%= order.orderId %></p>
    </div>
    
    <div class="flex items-center space-x-4">
      <div class="px-4 py-2 bg-gold-500/10 border border-gold-500/20 rounded-xl">
        <span class="text-[10px] font-bold uppercase tracking-widest text-gold-600 dark:text-gold-400">Current Status: <%= order.status %></span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Core Details -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Timeline & Info -->
      <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
        <div class="flex items-center space-x-3 mb-10">
          <div class="w-10 h-10 bg-gold-500/10 rounded-xl flex items-center justify-center">
            <i class="fa-solid fa-circle-info text-gold-600"></i>
          </div>
          <h3 class="text-lg font-serif font-bold dark:text-white">General Overview</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-8 gap-x-12">
          <div class="flex items-center space-x-4">
            <div class="p-3 bg-gray-50 dark:bg-luxury-black rounded-xl">
              <i class="fa-solid fa-user text-gray-400 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Customer</p>
              <p class="text-sm font-bold dark:text-white mt-0.5"><%= order.userId?.name %></p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <div class="p-3 bg-gray-50 dark:bg-luxury-black rounded-xl">
              <i class="fa-solid fa-calendar text-gray-400 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Order Placed</p>
              <p class="text-sm font-bold dark:text-white mt-0.5"><%= order.createdAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <div class="p-3 bg-gray-50 dark:bg-luxury-black rounded-xl">
              <i class="fa-solid fa-credit-card text-gray-400 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Payment Method</p>
              <p class="text-sm font-bold dark:text-white mt-0.5 uppercase tracking-wide"><%= order.payment.method %></p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <div class="p-3 bg-gray-50 dark:bg-luxury-black rounded-xl">
              <i class="fa-solid fa-receipt text-gray-400 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Payment Status</p>
              <span class="text-xs font-bold <%= order.payment.status === 'paid' ? 'text-green-500' : 'text-orange-500' %> mt-0.5 uppercase"><%= order.payment.status %></span>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-10 border-t border-gray-100 dark:border-white/5">
          <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mb-4">Advance Order Status</p>
          <form action="/admin/orders/<%= order._id %>/status?_method=PATCH" method="POST" class="flex items-center space-x-4 order-status-form">
            <div class="relative flex-grow">
              <select name="status" data-status="<%= order.status %>" class="status-select w-full pl-5 pr-12 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm font-bold dark:text-white appearance-none">
                <option value="confirmed" <%= order.status === "pending"||order.status === "confirmed" ? "selected" : "" %>>Confirmed</option>                    
                <option value="shipped" <%= order.status === "shipped" ? "selected" : "" %>>Shipped</option>
                <option value="Out of delivery" <%= order.status === "Out of delivery" ? "selected" : "" %>>Out of Delivery</option>
                <option value="delivered" <%= order.status === "delivered" ? "selected" : "" %>>Delivered</option>
                <option value="cancelled" <%= order.status === "cancelled" ? "selected" : "" %>>Cancelled</option>
                <option value="returned" <%= order.status === "returned" ? "selected" : "" %>>Returned</option>
              </select>
              <i class="fa-solid fa-chevron-down absolute right-6 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"></i>
            </div>
            <button type="submit" class="update-btn px-8 py-4 bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black rounded-2xl text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-lg disabled:opacity-50">
              Update Order
            </button>
          </form>
        </div>
      </div>

      <!-- Order Items -->
      <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
        <div class="p-8 border-b border-gray-100 dark:border-white/5">
          <h3 class="text-lg font-serif font-bold dark:text-white">Ordered Collections</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 dark:bg-luxury-black/30 border-b border-gray-100 dark:border-white/5">
                <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Product</th>
                <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 text-center">Qty</th>
                <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Item Status</th>
                <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 dark:divide-white/5">
              <% order.products.forEach((product, index) => { %>
                <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                  <td class="px-8 py-6">
                    <div class="flex items-center space-x-4">
                      <div class="w-12 h-12 bg-gray-50 dark:bg-luxury-black rounded-xl overflow-hidden border border-gray-100 dark:border-white/5 shadow-sm">
                        <img src="<%= product.image?.url %>" class="w-full h-full object-cover">
                      </div>
                      <p class="text-sm font-bold dark:text-white"><%= product.productName %></p>
                    </div>
                  </td>
                  <td class="px-8 py-6 text-center">
                    <span class="text-sm font-bold dark:text-gray-300">x<%= product.quantity %></span>
                  </td>
                  <td class="px-8 py-6">
                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest bg-gray-100 dark:bg-luxury-black text-gray-500 dark:text-gray-400">
                      <%= product.status %>
                    </span>
                  </td>
                  <td class="px-8 py-6 text-right">
                    <div class="flex items-center justify-end space-x-2">
                      <% if(product.return.isRequested && !product.return.adminReason){ %>
                        <button onclick="Approve('<%= order._id %>', '<%= index %>')" class="p-2 bg-green-500/10 text-green-600 rounded-lg hover:bg-green-500 hover:text-white transition-all">
                          <i class="fa-solid fa-check text-xs"></i>
                        </button>
                        <button onclick="openRejectModal('<%= order._id %>', '<%= index %>')" class="p-2 bg-red-500/10 text-red-500 rounded-lg hover:bg-red-500 hover:text-white transition-all">
                          <i class="fa-solid fa-xmark text-xs"></i>
                        </button>
                      <% } else if (product.return.reason) { %>
                        <button onclick="showReasonModal('<%= product.return.reason %>')" class="text-[10px] font-bold uppercase tracking-widest text-gold-600 underline">View Reason</button>
                      <% } else { %>
                        <span class="text-xs text-gray-300">—</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Sidebar Info -->
    <div class="space-y-8">
      
      <!-- Shipping Address -->
      <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
        <h4 class="text-lg font-serif font-bold dark:text-white mb-6">Dispatch Details</h4>
        <div class="space-y-4">
          <div class="flex items-start space-x-3">
            <i class="fa-solid fa-map-location-dot text-gold-600 mt-1"></i>
            <div>
              <p class="text-sm font-bold dark:text-white"><%= order.shippingAddress.fullName %></p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">
                <%= order.shippingAddress.street %><br>
                <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                <%= order.shippingAddress.pin %><br>
                <span class="inline-block mt-2 font-mono text-gold-600 dark:text-gold-400"><%= order.shippingAddress.mobile %></span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Financial Summary -->
      <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
        <h4 class="text-lg font-serif font-bold dark:text-white mb-6">Financial Ledger</h4>
        <div class="space-y-4">
          <div class="flex justify-between text-xs">
            <span class="text-gray-400 font-medium">Subtotal</span>
            <span class="font-bold dark:text-white">₹<%= order.totalOrderPrice %></span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-gray-400 font-medium">Coupon Savings</span>
            <span class="font-bold text-green-500">
              <%= order.couponDiscount ? '-' + order.couponDiscount + '%' : 'None' %>
            </span>
          </div>
          <% if(order.deliveryCharge) { %>
            <div class="flex justify-between text-xs">
              <span class="text-gray-400 font-medium">Shipping Logistics</span>
              <span class="font-bold dark:text-white">₹<%= order.deliveryCharge %></span>
            </div>
          <% } %>
          <div class="flex justify-between text-xs pt-4 border-t border-gray-50 dark:border-white/5">
            <span class="text-gray-400 font-medium uppercase tracking-widest">Grand Total</span>
            <span class="text-lg font-serif font-bold text-gold-600 dark:text-gold-400">₹<%= order.finalAmount %></span>
          </div>
        </div>
      </div>

      <!-- Global Return Request -->
      <% if(order.return.isRequested) { %>
        <div class="bg-red-50 dark:bg-red-500/10 p-8 rounded-[2.5rem] border border-red-100 dark:border-red-500/20 animate-pulse-slow">
          <h4 class="text-sm font-bold text-red-800 dark:text-red-400 uppercase tracking-widest mb-4 flex items-center">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i> Return Requested
          </h4>
          <p class="text-xs text-red-700 dark:text-red-300 font-medium leading-relaxed">
            "<%= order.return.reason %>"
          </p>
          <div class="grid grid-cols-2 gap-3 mt-6">
            <button onclick="Approve('<%= order._id %>')" class="py-3 bg-red-600 text-white rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-red-700 transition-all">Approve</button>
            <button onclick="openRejectModal('<%= order._id %>')" class="py-3 bg-white dark:bg-luxury-black text-red-600 rounded-xl text-[10px] font-bold uppercase tracking-widest border border-red-100 dark:border-white/5 hover:bg-red-50 transition-all">Reject</button>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reason Modal -->
<div id="reasonModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-luxury-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-luxury-charcoal w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
      <div class="p-10">
        <h3 class="text-xl font-serif font-bold dark:text-white mb-6">Return Justification</h3>
        <div id="returnReasonText" class="p-6 bg-gray-50 dark:bg-luxury-black rounded-2xl text-sm text-gray-600 dark:text-gray-400 font-medium italic leading-relaxed"></div>
        <button onclick="closeModal('reasonModal')" class="mt-8 w-full py-4 bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black rounded-2xl text-[10px] font-bold uppercase tracking-widest">Close Record</button>
      </div>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-luxury-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-luxury-charcoal w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
      <form id="rejectReturnForm" method="POST" class="p-10">
        <h3 class="text-xl font-serif font-bold dark:text-white mb-6">Refusal Protocol</h3>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Rejection Rationale</label>
        <textarea name="rejectReason" required rows="4" placeholder="Explain the reason for denial..." class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-red-500/20 focus:border-red-500 transition-all text-sm dark:text-white resize-none mb-8"></textarea>
        
        <div class="grid grid-cols-2 gap-4">
          <button type="button" onclick="closeModal('rejectModal')" class="py-4 bg-gray-100 dark:bg-luxury-black text-[10px] font-bold uppercase tracking-widest text-gray-400 rounded-2xl hover:text-luxury-black transition-all">Cancel</button>
          <button type="submit" class="py-4 bg-red-600 text-white rounded-2xl text-[10px] font-bold uppercase tracking-widest hover:bg-red-700 transition-all shadow-lg shadow-red-600/20">Confirm Reject</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function showReasonModal(reason) {
    document.getElementById('returnReasonText').textContent = reason;
    document.getElementById('reasonModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function openRejectModal(orderId, index = null) {
    const url = index !== null
      ? `/admin/orders/${orderId}/return/reject?_method=PATCH&index=${index}`
      : `/admin/orders/${orderId}/return/reject?_method=PATCH`;
    document.getElementById("rejectReturnForm").action = url;
    document.getElementById('rejectModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  async function Approve(orderId, index = null) {
    const url = index !== null
      ? `/admin/orders/${orderId}/return/approve?index=${index}`
      : `/admin/orders/${orderId}/return/approve`;
    
    try {
      const res = await fetch(url, { method: 'PATCH' });
      if (res.ok) location.reload();
      else new Notyf().error('Failed to approve request');
    } catch (err) {
      new Notyf().error('Network communication error');
    }
  }

  // Status transition logic
  document.querySelectorAll('.order-status-form').forEach(form => {
    const select = form.querySelector('.status-select');
    const button = form.querySelector('.update-btn');
    let currentStatus = select.getAttribute('data-status');
    if(currentStatus === 'Out of delivery') currentStatus = 'out_of_delivery';

    const transitions = {
      pending: ["confirmed"],
      confirmed:["shipped", "Out of delivery","cancelled"],
      shipped: ["Out of delivery", "delivered"],
      out_of_delivery: ["delivered"],
      delivered: ['returned'],
      cancelled: [],
      returned: []
    };

    function lockOptions() {
      const allowed = transitions[currentStatus] || [];
      [...select.options].forEach(opt => {
        let val = opt.value === 'Out of delivery' ? 'out_of_delivery' : opt.value;
        opt.disabled = !(allowed.includes(val) || opt.value === select.getAttribute('data-status'));
      });
      button.disabled = allowed.length === 0;
    }
    lockOptions();
  });
</script>

<%- include('../partials/admin/footer.ejs') %>
