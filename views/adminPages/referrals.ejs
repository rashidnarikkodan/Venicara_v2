<%- include('../partials/admin/header.ejs') %>

<div class="space-y-10 animate-fade-in pb-20">
  
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Referral Ecosystem</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Monitor organic growth and incentive distribution</p>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Total Referrals -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all">
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Total Outreach</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight"><%= data.referredCount || 0 %></h3>
      <div class="mt-4 flex items-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        <span class="text-gold-500 mr-1"><i class="fa-solid fa-users"></i></span>
        Network Volume
      </div>
    </div>

    <!-- Active Referrers -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all">
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Active Referrers</p>
      <h3 class="text-2xl font-serif font-bold dark:text-white tracking-tight"><%= data.referrerCount || 0 %></h3>
      <div class="mt-4 flex items-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        <span class="text-blue-500 mr-1"><i class="fa-solid fa-user-plus"></i></span>
        Growth Agents
      </div>
    </div>

    <!-- Total Paid -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all">
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Total Rewarded</p>
      <h3 class="text-2xl font-serif font-bold text-green-600 dark:text-green-400 tracking-tight">₹<%= data.totalPaid %></h3>
      <div class="mt-4 flex items-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        <span class="text-green-500 mr-1"><i class="fa-solid fa-check-double"></i></span>
        Distributed
      </div>
    </div>

    <!-- Pending Rewards -->
    <div class="bg-white dark:bg-luxury-charcoal p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/30 transition-all">
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Pending Rewards</p>
      <h3 class="text-2xl font-serif font-bold text-orange-500 tracking-tight">₹<%= data.totalPending %></h3>
      <div class="mt-4 flex items-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        <span class="text-orange-500 mr-1"><i class="fa-solid fa-clock-rotate-left"></i></span>
        In Pipeline
      </div>
    </div>
  </div>

  <!-- Detailed Table -->
  <div class="bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5 overflow-hidden">
    <div class="p-8 border-b border-gray-100 dark:border-white/5 flex items-center justify-between">
      <h3 class="text-lg font-serif font-bold dark:text-white">Growth Ledger</h3>
      <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400"><%= referrals.length %> Engagements</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 dark:bg-luxury-black/30 border-b border-gray-100 dark:border-white/5">
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">No.</th>
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Referrer</th>
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Access Key</th>
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 text-center">Invites</th>
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Reward Status</th>
            <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-white/5">
          <% referrals.forEach((referral, idx) => { %>
            <tr class="group hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="px-8 py-6 text-xs font-mono font-bold text-gray-400"><%= idx + 1 + (currentPage - 1) * limit %></td>
              <td class="px-8 py-6">
                <span class="text-sm font-bold dark:text-white leading-tight uppercase tracking-wider"><%= referral.referrer || 'N/A' %></span>
              </td>
              <td class="px-8 py-6">
                <span class="text-[10px] font-mono font-bold text-gold-600 dark:text-gold-400"><%= referral.referralCodeUsed || 'N/A' %></span>
              </td>
              <td class="px-8 py-6 text-center">
                <span class="text-sm font-bold dark:text-gray-300"><%= referral.referred || 0 %></span>
              </td>
              <td class="px-8 py-6">
                <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest <%= referral.status === 'pending' ? 'bg-orange-500/10 text-orange-600' : 'bg-green-500/10 text-green-600' %>">
                  <%= referral.status %>
                </span>
              </td>
              <td class="px-8 py-6 text-right">
                <% if(referral.status === 'pending') { %>
                  <button onclick="approveReward(this)" data-id="<%= referral._id %>" class="px-6 py-2.5 bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest rounded-xl hover:scale-105 transition-transform shadow-md">
                    Verify & Release
                  </button>
                <% } else if(referral.status === 'claimed') { %>
                   <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400 italic">Disbursement Finalized</span>
                <% } else { %>
                   <span class="text-[10px] font-bold uppercase tracking-widest text-green-600">Verification Approved</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-8 py-6 bg-gray-50/50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        Record Sync: Page <%= currentPage %>
      </p>
      
      <div class="flex items-center space-x-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>
        <% } %>
        <div class="px-4 py-2 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-xs font-bold dark:text-white">
          <%= currentPage %>
        </div>
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-luxury-charcoal border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-500 transition-all">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  async function approveReward(btn) {
    const id = btn.getAttribute('data-id');
    if (!id || btn.disabled) return;
    
    try {
      const res = await fetch(`/admin/referrals/${id}`, { method: "PATCH" });
      const data = await res.json();
      if (data.success) {
        btn.innerHTML = '<i class="fa-solid fa-circle-check mr-2"></i>Approved';
        btn.classList.add('bg-green-500', 'text-white');
        btn.disabled = true;
        setTimeout(() => location.reload(), 800);
      } else {
        new Notyf().error(data.message || 'Verification failed');
      }
    } catch (error) {
      new Notyf().error('Network synchronization failure');
    }
  }
</script>

<%- include('../partials/admin/footer.ejs') %>