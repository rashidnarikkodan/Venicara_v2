<%- include('../partials/admin/header.ejs') %>

<div class="max-w-5xl mx-auto animate-fade-in pb-20">
  
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-10">
    <div>
      <h1 class="text-3xl font-serif font-bold dark:text-white">Edit Masterpiece</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 font-medium uppercase tracking-widest">Update details for <%= product.name %></p>
    </div>
    <a href="/admin/products" class="p-3 bg-white dark:bg-luxury-charcoal rounded-xl border border-gray-100 dark:border-white/5 shadow-sm text-gray-500 hover:text-gold-600 transition-colors">
      <i class="fa-solid fa-xmark text-lg"></i>
    </a>
  </div>

  <form id="editProductForm" method="POST" action="/admin/products/edit/<%=product._id%>?_method=PUT" enctype="multipart/form-data" class="space-y-8">
    
    <!-- General Information -->
    <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
      <div class="flex items-center space-x-3 mb-8">
        <div class="w-10 h-10 bg-gold-500/10 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-pen-nib text-gold-600 dark:text-gold-400"></i>
        </div>
        <h3 class="text-lg font-serif font-bold dark:text-white">Product Details</h3>
      </div>

      <div class="space-y-6">
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Product Name</label>
          <input type="text" id="name" name="name" value="<%=product.name%>" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
        </div>

        <div>
          <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Description</label>
          <textarea id="description" name="description" rows="5" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white resize-none"><%=product.description%></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Category</label>
            <div class="relative">
              <select name="categoryId" id="category" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white appearance-none">
                <option disabled>Select Category</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category._id %>" <%=category._id.toString()==product.category._id?'selected':''%>><%=category.name %></option>
                <% }) %>
              </select>
              <i class="fa-solid fa-chevron-down absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Search Tags</label>
            <input type="text" id="tags" name="tags" value="<%=product.tags?product.tags.join(', '):''%>" placeholder="eg: woody, fresh" class="w-full px-5 py-4 bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl outline-none focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 transition-all text-sm dark:text-white">
          </div>
        </div>
      </div>
    </div>

    <!-- Media Library -->
    <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
      <div class="flex items-center space-x-3 mb-8">
        <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-images text-blue-600 dark:text-blue-400"></i>
        </div>
        <h3 class="text-lg font-serif font-bold dark:text-white">Gallery Management</h3>
      </div>

      <!-- Current Images -->
      <div id="currentImages" class="flex flex-wrap gap-4 mb-10 p-6 bg-gray-50 dark:bg-luxury-black rounded-3xl border border-dashed border-gray-200 dark:border-white/10">
        <% product.images.forEach((image, index) => { %>
          <div id="preview-<%=index%>" class="relative group w-32 h-32 rounded-2xl overflow-hidden shadow-sm border border-white dark:border-white/5">
            <img src="<%=image.url%>" alt="Product image" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <button type="button" onclick="removeImg('<%= image.public_id %>', '<%= index %>', '<%= product._id %>')" class="absolute top-2 right-2 w-7 h-7 bg-red-500 text-white rounded-lg opacity-0 group-hover:opacity-100 transition-all shadow-lg flex items-center justify-center">
              <i class="fa-solid fa-trash-can text-[10px]"></i>
            </button>
          </div>
        <% }) %>
        <% if (product.images.length === 0) { %>
          <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mx-auto py-4 italic">No images currently uploaded</p>
        <% } %>
      </div>

      <!-- Upload New -->
      <div class="relative">
        <input type="file" name="images" multiple accept="image/*" id="imgInput" class="hidden">
        <div id="addImgDiv" class="border-2 border-dashed border-gray-200 dark:border-white/10 rounded-3xl p-10 text-center hover:border-gold-500 transition-all cursor-pointer group bg-gray-50/30">
          <div class="w-14 h-14 bg-white dark:bg-luxury-charcoal rounded-2xl shadow-sm flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-plus text-xl text-gray-400 group-hover:text-gold-500"></i>
          </div>
          <p class="text-xs font-bold dark:text-white uppercase tracking-widest">Append New Images</p>
        </div>
        <div id="previewContainer" class="flex flex-wrap justify-center gap-4 mt-8"></div>
      </div>
    </div>

    <!-- Pricing & Variants -->
    <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-white/5">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-green-500/10 rounded-xl flex items-center justify-center">
            <i class="fa-solid fa-layer-group text-green-600 dark:text-green-400"></i>
          </div>
          <h3 class="text-lg font-serif font-bold dark:text-white">Variants & Pricing</h3>
        </div>
        <button type="button" onclick="addVariant(document.querySelector('#variantList'))" class="text-[10px] font-bold uppercase tracking-widest text-gold-600 hover:text-gold-700 flex items-center">
          <i class="fa-solid fa-plus-circle mr-2 text-sm"></i> New Variant
        </button>
      </div>

      <div id="variantContainer">
        <ol id="variantList" class="space-y-4">
          <% variants.forEach((variant, index) => { %>
            <li class="p-6 bg-gray-50 dark:bg-luxury-black/40 rounded-2xl border border-gray-100 dark:border-white/5 relative group animate-fade-in-down mb-4">
              <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Base Price (₹)</label>
                  <input name="basePrice" type="number" value="<%=variant.basePrice%>" class="w-full px-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 rounded-xl outline-none focus:border-gold-500 transition-all text-sm dark:text-white">
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Discount (%)</label>
                  <input name="discount" type="number" value="<%=variant.discount%>" class="w-full px-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 rounded-xl outline-none focus:border-gold-500 transition-all text-sm dark:text-white">
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Stock</label>
                  <input name="stock" type="number" value="<%=variant.stock || 0%>" class="w-full px-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 rounded-xl outline-none focus:border-gold-500 transition-all text-sm dark:text-white">
                </div>
                <div class="relative">
                  <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">Volume (ml)</label>
                  <div class="flex items-center space-x-2">
                    <input name="volume" type="text" value="<%=variant.volume%>" class="flex-1 px-4 py-3 bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 rounded-xl outline-none focus:border-gold-500 transition-all text-sm dark:text-white">
                    <% if(index > 0) { %>
                      <button type="button" class="delete-variant-btn p-3 bg-red-500/10 text-red-500 rounded-xl hover:bg-red-500 hover:text-white transition-all">
                        <i class="fa-solid fa-trash-can pointer-events-none"></i>
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            </li>
          <% }) %>
        </ol>
      </div>
    </div>

    <!-- Feedback Container -->
    <div id="editProductError" class="hidden bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 text-red-800 dark:text-red-400 px-6 py-4 rounded-2xl flex items-center animate-shake">
      <i class="fa-solid fa-circle-exclamation mr-3"></i>
      <span id="errorText"></span>
    </div>

    <!-- Final Actions -->
    <div class="flex items-center justify-end space-x-4 pt-6">
      <a href="/admin/products" class="px-8 py-4 rounded-2xl bg-white dark:bg-luxury-charcoal text-[10px] font-bold uppercase tracking-widest text-gray-500 border border-gray-100 dark:border-white/5 hover:bg-gray-50 transition-all">
        Cancel
      </a>
      <button type="submit" class="px-12 py-4 rounded-2xl bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition-all shadow-xl shadow-gold-500/20">
        Update Product
      </button>
    </div>

  </form>
</div>

<script defer src="/js/product.js"></script>
<script>
  // Handle dynamic variant deletion
  document.getElementById('variantList').addEventListener('click', (e) => {
    const deleteBtn = e.target.closest('.delete-variant-btn');
    if (deleteBtn) {
      const li = deleteBtn.closest('li');
      const list = document.getElementById('variantList');
      if (list.children.length > 1) {
        li.classList.add('animate-fade-out');
        setTimeout(() => li.remove(), 300);
      }
    }
  });

  async function removeImg(public_id, index, id) {
    try {
      const res = await fetch(`/admin/products/edit/removeImg/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ public_id })
      });
      const data = await res.json();
      
      if (data.success) {
        const previewDiv = document.getElementById(`preview-${index}`);
        previewDiv.classList.add('animate-fade-out');
        setTimeout(() => previewDiv.remove(), 300);
        new Notyf().success('Image removed from library');
      } else {
        new Notyf().error(data.message || 'Cannot remove image');
      }
    } catch (err) {
      new Notyf().error('Network error occurred');
    }
  }

  const editProductForm = document.getElementById('editProductForm');
  editProductForm.addEventListener('submit', e => {
    e.preventDefault();
    const errors = [];
    
    const name = document.getElementById('name').value.trim();
    const description = document.getElementById('description').value.trim();
    const category = document.getElementById('category').value;

    if (!name) errors.push('Product name is required');
    if (!description) errors.push('Description is required');
    if (!category) errors.push('Category selection is mandatory');

    const basePrices = Array.from(document.getElementsByName('basePrice')).map(i => i.value.trim());
    const discounts = Array.from(document.getElementsByName('discount')).map(i => i.value.trim());
    const stocks = Array.from(document.getElementsByName('stock')).map(i => i.value.trim());
    const volumes = Array.from(document.getElementsByName('volume')).map(i => i.value.trim());

    volumes.forEach((vol, i) => {
      const bp = Number(basePrices[i]);
      const st = parseInt(stocks[i]);
      if (!bp || bp <= 0) errors.push(`Variant ${i + 1}: Invalid base price`);
      if (isNaN(st) || st < 0) errors.push(`Variant ${i + 1}: Invalid stock value`);
      if (!vol) errors.push(`Variant ${i + 1}: Volume required`);
    });

    const errorBox = document.getElementById('editProductError');
    const errorText = document.getElementById('errorText');

    if (errors.length > 0) {
      errorBox.classList.remove('hidden');
      errorText.innerHTML = errors[0];
      window.scrollTo({ top: errorBox.offsetTop - 100, behavior: 'smooth' });
    } else {
      errorBox.classList.add('hidden');
      
      // Sync new files before submit
      if (typeof getFinalFiles === 'function') {
        const dt = new DataTransfer();
        getFinalFiles().forEach(file => dt.items.add(file));
        document.getElementById('imgInput').files = dt.files;
      }
      
      editProductForm.submit();
    }
  });
</script>

<%- include('../partials/admin/header.ejs') %>