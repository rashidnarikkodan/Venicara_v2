<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%=title%> | Verify OTP</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script defer src="/js/forgotOTP.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'luxury-black': '#121212',
            'luxury-cream': '#f8f5f0',
            'gold-600': '#d4af37',
            'gold-500': '#e5c05b',
          },
          fontFamily: {
            'serif': ['Playfair Display', 'serif'],
            'sans': ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-cream min-h-screen flex items-center justify-center p-4">
  <div class="max-w-4xl w-full bg-white rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row">
    
    <!-- Left: Artistic Branding Section -->
    <div class="md:w-[45%] relative bg-luxury-black hidden md:block">
      <img src="/images/b&w.avif" alt="Verification" class="w-full h-full object-cover opacity-80">
      <div class="absolute inset-0 bg-gradient-to-t from-luxury-black via-transparent to-transparent"></div>
      <div class="absolute bottom-10 left-10 right-10">
         <img src="/images/logo.avif" class="w-32 mb-6 brightness-0 invert" alt="Venicara">
         <h2 class="text-2xl font-serif font-bold text-white mb-2 uppercase tracking-widest text-center">Verify Access</h2>
         <p class="text-gray-400 text-[10px] uppercase tracking-[0.2em] text-center">One step closer to your signature scent.</p>
      </div>
    </div>

    <!-- Right Form Section -->
    <div class="flex-1 p-8 sm:p-12 lg:p-16">
      <div class="mb-10">
        <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Enter OTP</h1>
        <p class="text-gray-500 text-sm italic">We've sent a 6-digit verification code to your registered email.</p>
      </div>

      <% if(messages.error && messages.error.length > 0) { %>
        <div class="mb-8 p-4 bg-red-50 border border-red-100 text-red-600 text-[10px] font-bold uppercase tracking-widest rounded-xl flex items-center shadow-sm">
          <i class="fa-solid fa-circle-exclamation mr-3"></i>
          <%= messages.error[0] %>
        </div>
      <% } %>

      <form action="/auth/forgot/otp" method="post" class="space-y-8">
        <div class="space-y-6">
          <input type="text" name="otp" placeholder="XXXXXX" class="w-full text-center text-3xl font-bold tracking-[0.5em] px-6 py-5 rounded-2xl bg-gray-50 border border-transparent focus:bg-white focus:ring-2 focus:ring-gold-500 transition outline-none text-luxury-black" maxlength="6">
          
          <div class="flex flex-col items-center space-y-4">
             <div class="flex items-center space-x-2 text-xs font-bold uppercase tracking-widest">
               <span class="text-gray-400">Expiring in</span>
               <span id="timer" class="text-gold-600">00:50s</span>
             </div>
             
             <div class="text-[10px] font-bold uppercase tracking-widest">
                <span class="text-gray-400">Didn't receive it?</span>
                <a href="#" id="resend-otp" class="text-gold-600 hover:text-luxury-black transition ml-2 border-b border-gold-600/30">Resend Code</a>
             </div>
          </div>
        </div>

        <button type="submit" class="w-full bg-luxury-black text-white py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl group">
          <span>Confirm Verification</span>
          <i class="fa-solid fa-shield-check ml-3 group-hover:scale-110 transition-transform"></i>
        </button>
      </form>

      <div class="mt-12 text-center pt-8 border-t border-gray-50">
        <a href="/auth/login" class="text-[10px] font-bold text-gray-400 hover:text-luxury-black uppercase tracking-widest transition">
          <i class="fa-solid fa-arrow-left mr-2"></i> Back to Login
        </a>
      </div>
    </div>
  </div>
</body>
</html>
