<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Server Error | VENICARA</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'luxury-black': '#121212',
            'luxury-cream': '#f8f5f0',
            'gold-600': '#d4af37',
          },
          fontFamily: {
            'serif': ['Playfair Display', 'serif'],
            'sans': ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-cream min-h-screen flex items-center justify-center p-4">
  <div class="max-w-2xl w-full bg-white rounded-[3rem] shadow-2xl overflow-hidden p-12 text-center relative">
    
    <div class="relative z-10">
      <img src="/images/logo.avif" class="w-48 mx-auto mb-16" alt="Venicara">
      
      <div class="mb-12">
        <h1 class="text-[12rem] font-serif font-black text-red-500 leading-none opacity-5 select-none absolute left-1/2 -translate-x-1/2 -top-16">500</h1>
        <h2 class="text-4xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-tight">Technical Disturbance</h2>
        <p class="text-gray-500 text-lg italic max-w-sm mx-auto">Our atelier is currently experiencing a rare complication. Our master perfumers are working to resolve it.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-12">
        <button onclick="history.back()" class="w-full sm:w-auto px-10 py-5 bg-luxury-black text-white rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl group">
          <i class="fa-solid fa-rotate-left mr-3 group-hover:-rotate-45 transition-transform"></i>
          Try Again
        </button>
        <button id="showErrorBtn" class="w-full sm:w-auto px-10 py-5 border-2 border-red-100 text-red-600 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-red-50 transition">
          Debug View
        </button>
      </div>

      <div id="errorDiv" class="hidden text-left bg-red-50 border border-red-100 rounded-2xl p-6 overflow-x-auto">
        <p class="text-[10px] font-mono text-red-700 leading-relaxed break-all">
          <%= message || "500 Internal Server Error: An unexpected complication occurred within our alchemy labs." %>
        </p>
      </div>
    </div>
  </div>

  <script>
    const showErrorBtn = document.getElementById('showErrorBtn');
    const errorDiv = document.getElementById('errorDiv');

    showErrorBtn.addEventListener('click', () => {
      errorDiv.classList.toggle('hidden');
    });
  </script>
</body>
</html>
