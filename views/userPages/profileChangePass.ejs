<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%=title%> | Change Password</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
  <script defer src="/js/toast.js"></script>
  <script defer src="/js/forgotPassChange.js"></script>
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-cream dark:bg-luxury-black text-luxury-black dark:text-luxury-white min-h-screen flex items-center justify-center p-4 transition-colors duration-300 relative">

  <!-- Floating Theme Toggle -->
  <div class="fixed top-6 right-6 z-50">
    <button id="theme-toggle" class="w-12 h-12 rounded-full bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 flex items-center justify-center text-gray-700 dark:text-gray-300 hover:text-gold-600 dark:hover:text-gold-400 transition shadow-lg" title="Toggle Theme">
      <i class="fa-solid fa-moon dark:hidden text-lg"></i>
      <i class="fa-solid fa-sun hidden dark:block text-lg"></i>
    </button>
  </div>

  <div class="max-w-4xl w-full bg-white dark:bg-luxury-charcoal rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row border border-gray-100 dark:border-white/5">
    <!-- Left Form Section -->
    <div class="flex-1 p-8 sm:p-12 lg:p-16">
      <div class="mb-10">
        <h1 class="text-3xl font-serif font-bold text-luxury-black dark:text-white mb-2 uppercase tracking-tight">Security Update</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm italic">Enhance your account's protection with a new password.</p>
      </div>

      <% if(messages.error && messages.error.length > 0) { %>
        <div class="mb-8 p-4 bg-red-50 dark:bg-red-500/10 border border-red-100 dark:border-red-500/20 text-red-600 dark:text-red-400 text-[10px] font-bold uppercase tracking-widest rounded-xl flex items-center">
          <i class="fa-solid fa-circle-exclamation mr-3"></i>
          <%= messages.error[0] %>
        </div>
      <% } %>

      <form action="/profile/changePassword?_method=PATCH" method="POST" id="form" class="space-y-6">
        <div class="space-y-2">
          <label class="text-[10px] font-bold text-luxury-black dark:text-gray-300 uppercase tracking-widest ml-4">Current Password</label>
          <div class="relative">
            <input type="password" id="oldPass" name="oldPassword" class="w-full px-6 py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/10 text-luxury-black dark:text-white focus:ring-2 focus:ring-gold-500 focus:bg-white dark:focus:bg-luxury-black transition outline-none text-sm font-medium" placeholder="••••••••">
            <div id="oldPassError" class="text-[9px] text-red-500 font-bold uppercase tracking-widest mt-1 ml-4"></div>
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-luxury-black dark:text-gray-300 uppercase tracking-widest ml-4">New Password</label>
          <div class="relative">
            <input type="password" id="pass" name="password" class="w-full px-6 py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/10 text-luxury-black dark:text-white focus:ring-2 focus:ring-gold-500 focus:bg-white dark:focus:bg-luxury-black transition outline-none text-sm font-medium" placeholder="••••••••">
            <div id="passError" class="text-[9px] text-red-500 font-bold uppercase tracking-widest mt-1 ml-4"></div>
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-luxury-black dark:text-gray-300 uppercase tracking-widest ml-4">Confirm New Password</label>
          <div class="relative">
            <input type="password" id="confirmPass" name="confirmPassword" class="w-full px-6 py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/10 text-luxury-black dark:text-white focus:ring-2 focus:ring-gold-500 focus:bg-white dark:focus:bg-luxury-black transition outline-none text-sm font-medium" placeholder="••••••••">
            <div id="confirmError" class="text-[9px] text-red-500 font-bold uppercase tracking-widest mt-1 ml-4"></div>
          </div>
        </div>

        <button type="submit" class="w-full bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 dark:hover:bg-gold-600 transition shadow-xl mt-4">
          Update Password
        </button>
      </form>

      <div class="mt-8 text-center">
        <a href="/profile" class="text-[10px] font-bold text-gray-400 hover:text-luxury-black dark:hover:text-white uppercase tracking-widest transition">
          <i class="fa-solid fa-arrow-left mr-2"></i> Return to Profile
        </a>
      </div>
    </div>

    <!-- Right Image Section -->
    <div class="hidden md:block md:w-[45%] relative">
      <img src="/images/blackshirtwtchperfume.avif" alt="Security" class="w-full h-full object-cover">
      <div class="absolute inset-0 bg-luxury-black/10"></div>
    </div>
  </div>

  <script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  </script>
</body>
</html>
