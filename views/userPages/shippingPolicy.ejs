<%- include("../partials/user/header.ejs") %>

<main class="bg-luxury-cream dark:bg-luxury-black min-h-screen py-20 transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <div class="mb-16 text-center animate-fade-in">
      <h1 class="text-5xl font-serif font-bold text-luxury-black dark:text-white mb-4">Shipping Policy</h1>
      <div class="w-24 h-1 bg-gold-500 mx-auto rounded-full"></div>
      <p class="text-[10px] text-gray-400 dark:text-gray-500 font-bold uppercase tracking-[0.3em] mt-6 italic">Delivering elegance to your doorstep</p>
    </div>
    
    <div class="space-y-12 text-gray-700 dark:text-gray-300 leading-relaxed font-sans animate-fade-in-down">
      <section class="bg-white dark:bg-luxury-charcoal p-10 rounded-[3rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/20 transition-all duration-500">
        <div class="flex items-center space-x-4 mb-6">
          <span class="text-2xl font-serif italic text-gold-500 opacity-50">01</span>
          <h2 class="text-xl font-bold text-luxury-black dark:text-white tracking-wide">Options & Logistics</h2>
        </div>
        <p class="text-sm leading-relaxed">We offer curated shipping options to ensure your fragrances arrive in pristine condition. Delivery costs are calculated dynamically at checkout based on your destination and the premium nature of the shipment.</p>
      </section>

      <section class="bg-white dark:bg-luxury-charcoal p-10 rounded-[3rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/20 transition-all duration-500">
        <div class="flex items-center space-x-4 mb-6">
          <span class="text-2xl font-serif italic text-gold-500 opacity-50">02</span>
          <h2 class="text-xl font-bold text-luxury-black dark:text-white tracking-wide">Processing Timelines</h2>
        </div>
        <p class="text-sm leading-relaxed">Each order is handled with artisan care. All orders are processed within 1-2 business days. Please note that to maintain the highest quality standards, shipments are not dispatched on weekends or public holidays.</p>
      </section>

      <section class="bg-white dark:bg-luxury-charcoal p-10 rounded-[3rem] shadow-sm border border-gray-100 dark:border-white/5 group hover:border-gold-500/20 transition-all duration-500">
        <div class="flex items-center space-x-4 mb-6">
          <span class="text-2xl font-serif italic text-gold-500 opacity-50">03</span>
          <h2 class="text-xl font-bold text-luxury-black dark:text-white tracking-wide">Global Estimates</h2>
        </div>
        <p class="text-sm leading-relaxed">Domestic deliveries typically reach their destination within 3-5 business days. International transit times vary by region, usually spanning 7-14 business days. You will receive a tracking code as soon as your package begins its journey.</p>
      </section>
    </div>

    <div class="mt-20 text-center">
      <a href="/" class="text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-gold-600 transition-colors">
        Return to Boutique
      </a>
    </div>
  </div>
</main>

<%- include("../partials/user/footer.ejs") %>
