<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Not Found | VENICARA</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'luxury-black': '#121212',
            'luxury-cream': '#f8f5f0',
            'gold-600': '#d4af37',
          },
          fontFamily: {
            'serif': ['Playfair Display', 'serif'],
            'sans': ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-cream min-h-screen flex items-center justify-center p-4">
  <div class="max-w-2xl w-full bg-white rounded-[3rem] shadow-2xl overflow-hidden p-12 text-center relative">
    <!-- Background Texture -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/cubes.png')"></div>
    
    <div class="relative z-10">
      <img src="/images/logo.avif" class="w-48 mx-auto mb-16" alt="Venicara">
      
      <div class="mb-12">
        <h1 class="text-[12rem] font-serif font-black text-luxury-black leading-none opacity-5 select-none absolute left-1/2 -translate-x-1/2 -top-16">404</h1>
        <h2 class="text-4xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-tight">The Scent is Gone</h2>
        <p class="text-gray-500 text-lg italic max-w-sm mx-auto">The path you seek has faded into the air. Like a ghost note, this page no longer exists.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <button onclick="history.back()" class="w-full sm:w-auto px-10 py-5 bg-luxury-black text-white rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl group">
          <i class="fa-solid fa-arrow-left mr-3 group-hover:-translate-x-1 transition-transform"></i>
          Retrace Steps
        </button>
        <a href="/home" class="w-full sm:w-auto px-10 py-5 border-2 border-luxury-black text-luxury-black rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-luxury-black hover:text-white transition group">
          Back to Boutique
          <i class="fa-solid fa-house ml-3 group-hover:scale-110 transition-transform"></i>
        </a>
      </div>
    </div>

    <!-- Luxury Footer -->
    <div class="mt-20 pt-10 border-t border-gray-50 flex justify-center space-x-8">
      <i class="fa-brands fa-instagram text-gray-300 hover:text-luxury-black transition text-xl"></i>
      <i class="fa-brands fa-facebook text-gray-300 hover:text-luxury-black transition text-xl"></i>
      <i class="fa-brands fa-pinterest text-gray-300 hover:text-luxury-black transition text-xl"></i>
    </div>
  </div>
</body>
</html>
