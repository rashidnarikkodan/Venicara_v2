<%-include('../partials/user/header.ejs')%>

<main class="bg-white min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12">
      
      <%- include("../partials/user/sidebarProfile.ejs") %>

      <!-- Main Content -->
      <div class="flex-1">
        <div class="mb-10">
          <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Refer & Earn</h1>
          <p class="text-gray-500 text-sm italic">Share the luxury of Venicara with your circle.</p>
        </div>

        <div class="flex flex-col xl:flex-row gap-8">
          <!-- Referral Card -->
          <div class="flex-1 bg-white border border-gray-100 rounded-[3rem] p-8 sm:p-16 text-center shadow-sm relative overflow-hidden">
            <!-- Luxury Decoration -->
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-gold-500/5 rounded-full blur-3xl"></div>
            
            <div class="relative z-10">
              <div class="w-24 h-24 bg-luxury-cream rounded-full flex items-center justify-center mx-auto mb-8">
                <i class="fa-solid fa-gift text-4xl text-gold-600"></i>
              </div>
              
              <h2 class="text-2xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-widest">Invite Your Connoisseurs</h2>
              <p class="text-gray-500 text-sm mb-10 max-w-md mx-auto leading-relaxed">
                Gift your friends the experience of artisanal fragrances. When they join using your code, you both unlock exclusive rewards up to <span class="font-bold text-luxury-black">Rs.200</span>.
              </p>

              <div class="mb-12">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mb-4">Your Private Invitation Code</p>
                <div class="inline-flex items-center space-x-4 bg-gray-50 border-2 border-dashed border-gray-200 px-8 py-4 rounded-2xl">
                  <span class="text-2xl font-serif font-bold text-luxury-black tracking-[0.3em] ml-2"><%=referralCode%></span>
                </div>
              </div>

              <button onclick="copyMessage(this)" class="w-full max-w-sm mx-auto bg-luxury-black text-white py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl group">
                <span id="copyText">Copy Invitation Message</span>
                <i class="fa-solid fa-copy ml-3 group-hover:scale-110 transition-transform"></i>
              </button>
            </div>
          </div>

          <!-- Rewards Sidebar -->
          <% if(rewards && rewards.length) { %>
            <div class="w-full xl:w-96">
              <div class="bg-luxury-cream/50 border border-gold-100 rounded-[2.5rem] p-8">
                <h3 class="text-xs font-bold text-luxury-black uppercase tracking-widest mb-8 pb-4 border-b border-gold-200/50">Your Rewards</h3>
                
                <div id="rewardList" class="space-y-4">
                  <% rewards.forEach(reward => { %>
                    <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center justify-between group hover:border-gold-300 transition">
                      <div class="flex-1">
                        <h4 class="text-xs font-bold text-luxury-black mb-1">Referral Reward</h4>
                        <p class="text-[10px] font-bold text-gold-600 uppercase tracking-widest">₹<%=reward.amount%></p>
                      </div>
                      <button 
                        class="claim-reward px-4 py-2 bg-luxury-black text-white rounded-full text-[9px] font-bold uppercase tracking-widest hover:bg-gold-600 transition disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed" 
                        data-id="<%= reward._id %>"
                        <%= (reward.status === 'claimed' || reward.status === 'pending') ? 'disabled' : '' %>>
                        <%= reward.status === 'claimed' ? 'Claimed' : reward.status === 'pending' ? 'Pending' : 'Claim Now' %>
                      </button>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function copyMessage(btn) {
    const code = '<%=referralCode%>';
    const message = `Discover artisanal luxury at Venicara. Join using my exclusive code: ${code} and unlock special rewards on your first purchase!`;
    const copyText = document.getElementById('copyText');
    
    navigator.clipboard.writeText(message).then(() => {
      const originalText = copyText.innerText;
      copyText.innerText = 'Invitation Copied!';
      btn.classList.replace('bg-luxury-black', 'bg-green-600');
      
      setTimeout(() => {
        copyText.innerText = originalText;
        btn.classList.replace('bg-green-600', 'bg-luxury-black');
      }, 2000);
    });
  }

  document.getElementById('rewardList')?.addEventListener('click', async (e) => {
    const btn = e.target.closest('.claim-reward');
    if (btn) {
      const id = btn.getAttribute('data-id');
      const originalText = btn.innerText;
      
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i>';

      try {
        const res = await fetch('/referEarn/api/reward', {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id })
        });
        const data = await res.json();
        
        if (data.status) {
          btn.innerText = 'Claimed';
          if(typeof Notyf !== 'undefined') new Notyf().success('Reward claimed to wallet!');
        } else {
          btn.innerText = originalText;
          btn.disabled = false;
          if(typeof Notyf !== 'undefined') new Notyf().error(data.message);
        }
      } catch (err) {
        btn.innerText = originalText;
        btn.disabled = false;
        if(typeof Notyf !== 'undefined') new Notyf().error('Network error');
      }
    }
  });
</script>

<%-include('../partials/user/footer.ejs')%>