<%- include("../partials/user/header.ejs") %>

<main class="bg-white min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Checkout Progress -->
    <div class="mb-12">
      <div class="flex items-center justify-center space-x-4 mb-8">
        <div class="flex items-center text-gold-600 font-bold text-xs tracking-widest uppercase">
          <i class="fa-solid fa-circle-check mr-2"></i>
          <span class="hidden sm:inline">Address</span>
        </div>
        <div class="w-8 sm:w-12 h-px bg-gold-500"></div>
        <div class="flex items-center text-luxury-black font-bold text-xs tracking-widest uppercase">
          <span class="w-8 h-8 rounded-full bg-luxury-black text-white flex items-center justify-center mr-3">2</span>
          <span class="hidden sm:inline">Payment</span>
        </div>
        <div class="w-8 sm:w-12 h-px bg-gray-100"></div>
        <div class="flex items-center text-gray-400 font-bold text-xs tracking-widest uppercase">
          <span class="w-8 h-8 rounded-full border-2 border-gray-100 flex items-center justify-center mr-3">3</span>
          <span class="hidden sm:inline">Review</span>
        </div>
      </div>
      <h1 class="text-3xl font-serif font-bold text-luxury-black text-center mb-2">Secure Checkout</h1>
      <p class="text-gray-500 text-center text-sm">Choose your preferred payment method to complete the journey.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-16">
      <!-- Payment Methods -->
      <div class="flex-1">
        <div class="space-y-6">
          <% paymentMethods.forEach((method, i) => { %>
            <% 
               const isDisabled = method.code === 'COD' && Number(total) > 7000;
               const isChecked = i === 1 && method.code !== 'COD';
            %>
            <label class="relative block group cursor-pointer <%= isDisabled ? 'opacity-50 cursor-not-allowed' : '' %>">
              <input type="radio" name="paymentMethod" value="<%= method.code %>" class="peer sr-only" <%= isDisabled ? 'disabled' : '' %> <%= isChecked ? 'checked' : '' %>>
              <div class="border-2 border-gray-100 rounded-2xl p-6 sm:p-8 transition-all duration-300 peer-checked:border-gold-500 peer-checked:bg-gold-50/30 hover:border-gray-200 shadow-sm hover:shadow-md flex items-center justify-between">
                <div class="flex items-center space-x-6">
                  <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gray-50 rounded-xl flex items-center justify-center group-hover:bg-white transition duration-300">
                    <% if(method.code === 'COD') { %>
                      <i class="fa-solid fa-hand-holding-dollar text-xl sm:text-2xl text-gray-400 group-hover:text-gold-600"></i>
                    <% } else if(method.code === 'RAZORPAY') { %>
                      <i class="fa-solid fa-credit-card text-xl sm:text-2xl text-gray-400 group-hover:text-gold-600"></i>
                    <% } else if(method.code === 'WALLET') { %>
                      <i class="fa-solid fa-wallet text-xl sm:text-2xl text-gray-400 group-hover:text-gold-600"></i>
                    <% } %>
                  </div>
                  <div>
                    <h3 class="text-base sm:text-lg font-bold text-luxury-black"><%= method.name %></h3>
                    <% if(method.code === 'WALLET') { %>
                      <p class="text-[10px] sm:text-xs font-bold text-gold-600 uppercase tracking-widest mt-1">Available Balance: Rs.<%= balance.toLocaleString() %></p>
                    <% } else if(isDisabled) { %>
                      <p class="text-[10px] sm:text-xs text-red-500 font-medium mt-1 italic">Not available for orders above Rs.7,000</p>
                    <% } else { %>
                      <p class="text-[10px] sm:text-xs text-gray-400 mt-1">Fast and secure payment processing</p>
                    <% } %>
                  </div>
                </div>
                <div class="opacity-0 peer-checked:opacity-100 transition-opacity">
                  <i class="fa-solid fa-circle-check text-gold-500 text-xl sm:text-2xl"></i>
                </div>
              </div>
            </label>
          <% }) %>
        </div>

        <!-- Coupons Section -->
        <div class="mt-12 pt-12 border-t border-gray-100">
          <h2 class="text-xl font-serif font-bold text-luxury-black mb-8 flex items-center">
            <i class="fa-solid fa-tags text-gold-500 mr-3"></i> Available Coupons
          </h2>
          <% if(coupons && coupons.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="couponList">
              <% coupons.forEach(c => { %>
                <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 flex justify-between items-center group hover:bg-white hover:border-gold-200 transition duration-300">
                  <div class="flex-1">
                    <div class="flex items-center space-x-2 mb-1">
                      <span class="text-sm font-bold text-luxury-black tracking-widest uppercase"><%= c.code %></span>
                      <span class="bg-gold-500 text-white text-[10px] px-2 py-0.5 rounded-full font-bold"><%= c.discount %>% OFF</span>
                    </div>
                    <p class="text-[10px] text-gray-500 uppercase tracking-widest">Min. Order: Rs.<%= c.minPrice %></p>
                  </div>
                  <button class="copy-coupon text-[10px] font-bold uppercase tracking-widest text-gold-600 hover:text-gold-700 transition px-3 py-2 border border-gold-100 rounded-lg bg-white" data-code="<%= c.code %>">
                    Copy
                  </button>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-gray-400 italic text-sm">No coupons available at the moment.</p>
          <% } %>
        </div>
      </div>

      <!-- Order Summary Sidebar -->
      <div class="w-full lg:w-96">
        <div class="bg-luxury-cream rounded-3xl p-8 border border-gold-100 sticky top-24">
          <h2 class="text-xl font-serif font-bold text-luxury-black mb-8 pb-4 border-b border-gold-200/50">Final Summary</h2>
          
          <div class="space-y-4 mb-8">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Order Amount</span>
              <span class="font-bold text-luxury-black">Rs.<%= (total - (deliveryCharge || 0)).toLocaleString() %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Delivery</span>
              <span class="text-green-600 font-bold uppercase tracking-widest text-[10px]"><%= deliveryCharge ? `Rs.${deliveryCharge}` : 'Free' %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Coupon Discount</span>
              <span id="couponDisc" class="text-red-500 font-bold">-Rs.0</span>
            </div>
          </div>

          <!-- Coupon Input -->
          <div class="mb-8">
            <div class="relative">
              <input type="text" id="coupon" placeholder="Discount Code" class="w-full bg-white border border-gray-200 rounded-full px-6 py-4 text-sm focus:ring-gold-500 focus:border-gold-500 outline-none uppercase tracking-widest font-bold pr-24">
              <button id="couponApplyBtn" class="absolute right-2 top-2 bottom-2 bg-luxury-black text-white px-5 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-gold-600 transition">Apply</button>
            </div>
            <p id="couponMessage" class="mt-2 text-[10px] text-red-500 uppercase tracking-widest hidden"></p>
            <button id="cancelCouponBtn" onclick="cancelCoupon()" class="mt-2 text-[10px] text-gold-600 font-bold uppercase tracking-widest hidden hover:underline">Remove Coupon</button>
          </div>

          <div class="flex justify-between items-center mb-10 pt-6 border-t border-luxury-black/10">
            <span class="text-lg font-serif font-bold text-luxury-black">Grand Total</span>
            <span id="totalAmount" class="text-2xl font-bold text-gold-700">Rs.<%= total.toLocaleString() %></span>
          </div>

          <button id="continue" class="block w-full bg-luxury-black text-white text-center py-5 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-gold-600 transition shadow-xl">
            Place Your Order
          </button>
          
          <p class="mt-6 text-[10px] text-gray-400 text-center uppercase tracking-widest leading-relaxed">
            Secure 256-bit SSL Encrypted Payment <br>
            <span class="flex items-center justify-center mt-2 space-x-2">
              <i class="fa-solid fa-lock text-[10px]"></i>
              <span>Guaranteed Safe Checkout</span>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Payment Failed Modal -->
  <div id="paymentFailedModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity duration-300"></div>
    <div class="relative bg-white rounded-3xl p-8 sm:p-10 max-w-md w-full shadow-2xl text-center transform transition-transform duration-300 scale-95 opacity-0" id="modalContent">
      <div class="w-20 h-20 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6 text-red-500">
        <i class="fa-solid fa-circle-exclamation text-4xl"></i>
      </div>
      <h2 class="text-2xl font-serif font-bold text-luxury-black mb-4">Payment Unsuccessful</h2>
      <p id="paymentFailedMessage" class="text-gray-500 mb-10">We couldn't process your payment. Please try another method or check your orders.</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <button onclick="hideModal()" class="flex-1 py-4 border-2 border-gray-100 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-gray-50 transition order-2 sm:order-1">Try Again</button>
        <button id="retry" class="flex-1 py-4 bg-luxury-black text-white rounded-full font-bold text-xs uppercase tracking-widest hover:bg-gold-600 transition shadow-lg order-1 sm:order-2">View My Orders</button>
      </div>
    </div>
  </div>
</main>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  // Modal Logic
  function showPaymentFailedModal(message) {
    const modal = document.getElementById('paymentFailedModal');
    const content = document.getElementById('modalContent');
    const messageEl = document.getElementById('paymentFailedMessage');
    
    if(message) messageEl.textContent = message;
    
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function hideModal() {
    const modal = document.getElementById('paymentFailedModal');
    const content = document.getElementById('modalContent');
    
    content.classList.add('scale-95', 'opacity-0');
    content.classList.remove('scale-100', 'opacity-100');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }

  // Payment Logic
  document.getElementById("continue").addEventListener("click", async (e) => {
    e.preventDefault();
    const btn = e.currentTarget;
    const originalText = btn.innerHTML;

    try {
      const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;
      if (!paymentMethod) throw new Error("Please select a payment method.");

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin mr-2"></i> Initializing...';

      const response = await fetch("/checkout/api/placeOrder", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ paymentMethod }),
      });

      const data = await response.json();

      if (!data.status) {
        showPaymentFailedModal(data.message);
        btn.disabled = false;
        btn.innerHTML = originalText;
        return;
      }

      if (paymentMethod === "RAZORPAY" && data.razorpayOrderId) {
        const options = {
          key: "<%= process.env.RAZORPAY_KEY_ID %>",
          amount: data.totalAmount * 100,
          currency: "INR",
          name: "VENICARA",
          order_id: data.razorpayOrderId,
          prefill: {
            name: "<%= user.name %>",
            email: "<%= user.email %>",
            contact: "<%= user.mobile %>",
          },
          theme: { color: "#d4af37" }, // Gold primary
          handler: async function (response) {
            try {
              const res = await fetch("/checkout/api/razorpay/success", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  orderId: data.orderId,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_signature: response.razorpay_signature,
                }),
              });

              const result = await res.json();
              if (result.status) {
                window.location.href = `/checkout/placeOrder/${data.orderId}`;
              } else {
                showPaymentFailedModal(result.message);
              }
            } catch (err) {
              showPaymentFailedModal("Internal verification error.");
            }
          },
          modal: {
            escape: true,
            ondismiss: async () => {
              try {
                await fetch('/checkout/api/razorpay/failed', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ orderId: data.orderId })
                });
                showPaymentFailedModal("Payment cancelled or closed.");
                btn.disabled = false;
                btn.innerHTML = originalText;
              } catch (error) {
                console.error('Razorpay ondismiss error:', error);
              }
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();
        return;
      }

      window.location.href = `/checkout/placeOrder/${data.orderId}`;
    } catch (err) {
      showPaymentFailedModal(err.message);
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  document.getElementById('retry').addEventListener('click', () => {
    window.location.href = '/orders';
  });

  // Coupon Logic
  const couponInput = document.getElementById('coupon');
  const applyBtn = document.getElementById('couponApplyBtn');
  const cancelBtn = document.getElementById('cancelCouponBtn');
  const messageEl = document.getElementById('couponMessage');

  applyBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    const code = couponInput.value.trim();
    if(!code) return;

    applyBtn.disabled = true;
    applyBtn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i>';

    try {
      const res = await fetch('/checkout/api/coupon/apply', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const data = await res.json();
      
      if (data.status) {
        couponInput.readOnly = true;
        applyBtn.classList.add('hidden');
        cancelBtn.classList.remove('hidden');
        messageEl.classList.remove('hidden', 'text-red-500');
        messageEl.classList.add('text-green-600');
        messageEl.textContent = 'Coupon Applied Successfully!';
        
        document.getElementById('couponDisc').innerHTML = `-Rs.${data.discount.toLocaleString()}`;
        document.getElementById('totalAmount').innerHTML = `Rs.${data.finalAmount.toLocaleString()}`;
        
        if(data.actualDiscount !== data.discPerc) {
          new Notyf().success(`Max discount of Rs.${data.discount} applied`);
        } else {
          new Notyf().success('Coupon applied!');
        }
      } else {
        messageEl.classList.remove('hidden', 'text-green-600');
        messageEl.classList.add('text-red-500');
        messageEl.textContent = data.message;
        applyBtn.disabled = false;
        applyBtn.innerHTML = 'Apply';
      }
    } catch (error) {
      new Notyf().error('Failed to apply coupon');
      applyBtn.disabled = false;
      applyBtn.innerHTML = 'Apply';
    }
  });

  async function cancelCoupon() {
    try {
      const res = await fetch('/checkout/api/coupon/cancel', { method: 'PATCH' });
      const data = await res.json();
      
      if (data.status) {
        couponInput.readOnly = false;
        couponInput.value = '';
        applyBtn.classList.remove('hidden');
        applyBtn.disabled = false;
        applyBtn.innerHTML = 'Apply';
        cancelBtn.classList.add('hidden');
        messageEl.classList.add('hidden');
        
        document.getElementById('couponDisc').innerHTML = '-Rs.0';
        document.getElementById('totalAmount').innerHTML = `Rs.${data.finalAmount.toLocaleString()}`;
        new Notyf().success('Coupon removed');
      }
    } catch (error) {
      new Notyf().error('Failed to remove coupon');
    }
  }

  // Coupon Copy
  document.getElementById('couponList')?.addEventListener('click', (e) => {
    const copyBtn = e.target.closest('.copy-coupon');
    if (copyBtn) {
      const code = copyBtn.dataset.code;
      navigator.clipboard.writeText(code).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        copyBtn.classList.add('text-green-600', 'border-green-100');
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.classList.remove('text-green-600', 'border-green-100');
        }, 2000);
      });
    }
  });
</script>

<%- include("../partials/user/footer.ejs") %>

