<%- include('../partials/user/header.ejs') %>

<main class="min-h-[85vh] flex flex-col items-center justify-center bg-white px-4 relative overflow-hidden">
  
  <!-- Artistic Background Element -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold-400/5 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- Success Animation -->
  <div class="mb-8 relative">
    <lottie-player
      src="https://assets2.lottiefiles.com/packages/lf20_jbrw3hcz.json"
      background="transparent"
      speed="1"
      class="w-80 h-80 sm:w-[35rem] sm:h-[25rem] relative z-10"
      autoplay>
    </lottie-player>
  </div>

  <!-- Content -->
  <div class="text-center max-w-lg relative z-10">
    <div class="animate-slide-up">
      <h6 class="text-gold-600 font-bold tracking-[0.4em] uppercase text-[10px] mb-4">Gratitude & Elegance</h6>
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-luxury-black mb-6 uppercase tracking-tight">Your Acquisition <br> is Confirmed</h1>
      <p class="text-gray-500 text-sm italic mb-10 leading-relaxed">
        Your order <span class="text-luxury-black font-bold not-italic tracking-widest bg-luxury-cream px-3 py-1 rounded-lg border border-gold-100"><%= orderId %></span> has been received with distinguished pleasure. We are now preparing your essence for its journey.
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/orders" class="w-full sm:w-auto px-12 py-5 bg-luxury-black text-white rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-2xl group">
          Track Acquisitions
          <i class="fa-solid fa-arrow-right ml-3 group-hover:translate-x-1 transition-transform"></i>
        </a>
        <a href="/shop" class="w-full sm:w-auto px-12 py-5 border-2 border-gray-100 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gray-50 transition">
          Continue Discovering
        </a>
      </div>
    </div>
  </div>

</main>

<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script>
  const player = document.querySelector('lottie-player');
  if(player) {
    player.addEventListener('ready', () => {
      player.setSpeed(0.8);
    });
  }
</script>

<%- include('../partials/user/footer.ejs') %>
