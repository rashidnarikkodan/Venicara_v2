<%- include('../partials/user/header.ejs') %>

<main class="min-h-[85vh] flex flex-col items-center justify-center bg-luxury-cream dark:bg-luxury-black px-4 py-16 relative overflow-hidden transition-colors duration-300">
  
  <!-- Artistic Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold-400/10 dark:bg-gold-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Content Container Card -->
  <div class="max-w-xl w-full mx-auto text-center relative z-10 bg-white/70 dark:bg-luxury-charcoal/80 backdrop-blur-md p-8 md:p-12 rounded-[2.5rem] border border-gray-200/80 dark:border-white/10 shadow-2xl transition-all duration-300">
    <div class="animate-slide-up">

      <!-- Success Animation -->
      <div class="relative w-28 h-28 md:w-36 md:h-36 mx-auto mb-6 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-emerald-500/20 dark:bg-emerald-400/20 blur-xl"></div>
        <lottie-player
          src="https://assets2.lottiefiles.com/packages/lf20_jbrw3hcz.json"
          background="transparent"
          speed="1"
          class="w-full h-full relative z-10"
          autoplay>
        </lottie-player>
      </div>

      <!-- Typography -->
      <span class="inline-block text-gold-600 dark:text-gold-400 font-bold tracking-[0.4em] uppercase text-xs mb-3">Gratitude &amp; Elegance</span>
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-luxury-black dark:text-white mb-6 uppercase tracking-tight leading-tight">
        Your Acquisition <br>
        <span class="italic font-normal text-gold-600 dark:text-gold-400">is Confirmed</span>
      </h1>
      
      <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed mb-8 max-w-md mx-auto">
        Your order <span class="inline-block mx-1 font-mono font-bold text-luxury-black dark:text-gold-300 bg-gold-50 dark:bg-luxury-black px-3 py-1 rounded-lg border border-gold-200 dark:border-gold-500/30 shadow-sm"><%= orderId %></span> has been received with distinguished pleasure. We are now preparing your essence for its journey.
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a href="/orders" class="w-full sm:w-auto px-8 py-4 bg-luxury-black text-white dark:bg-gold-500 dark:text-black dark:hover:bg-gold-400 hover:bg-gold-600 rounded-full font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-xl hover:shadow-2xl flex items-center justify-center gap-3 group">
          <span>Track Acquisitions</span>
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
        <a href="/shop" class="w-full sm:w-auto px-8 py-4 border-2 border-gray-300 dark:border-white/20 text-gray-800 dark:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-400 dark:hover:border-white/40 rounded-full font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center justify-center">
          <span>Continue Discovering</span>
        </a>
      </div>
    </div>
  </div>

</main>

<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script>
  const player = document.querySelector('lottie-player');
  if(player) {
    player.addEventListener('ready', () => {
      player.setSpeed(0.8);
    });
  }
</script>

<%- include('../partials/user/footer.ejs') %>
