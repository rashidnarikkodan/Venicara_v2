<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | VENICARA</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/output.css" />
  <script src="https://kit.fontawesome.com/f45c5ea548.js" crossorigin="anonymous"></script>
</head>
<body class="h-full bg-luxury-cream dark:bg-luxury-black font-sans transition-colors duration-300 flex items-center justify-center p-6">

  <div class="max-w-4xl w-full bg-white dark:bg-luxury-charcoal rounded-[3rem] shadow-2xl overflow-hidden animate-zoom-in">
    <div class="flex flex-col md:flex-row">
      <!-- Form Side -->
      <div class="flex-1 p-10 md:p-16">
        <div class="mb-12">
          <img src="/images/logo.avif" alt="Venicara" class="w-40 mb-10 dark:invert">
          <h2 class="text-3xl font-serif font-bold text-luxury-black dark:text-white mb-2 uppercase tracking-tight">New Password</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm italic">Define your secure future presence.</p>
        </div>

        <% if(messages.error && messages.error.length > 0){ %>
          <div class="mb-8 p-4 bg-red-50 dark:bg-red-500/10 border border-red-100 dark:border-red-500/20 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-widest rounded-2xl flex items-center">
            <i class="fa-solid fa-circle-exclamation mr-3 text-sm"></i>
            <%= messages.error[0] %>
          </div>
        <% } %>

        <form action="/auth/forgot/change-password?_method=PATCH" method="POST" id="form" class="space-y-6">
          <div class="space-y-2">
            <label for="pass" class="text-[10px] font-bold text-luxury-black dark:text-gray-400 uppercase tracking-widest ml-4">New Secret Key</label>
            <div class="relative group">
              <span class="absolute left-6 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-gold-500 transition-colors">
                <i class="fa-solid fa-lock text-sm"></i>
              </span>
              <input type="password" id="pass" name="password" 
                     class="w-full bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl py-4 pl-14 pr-6 text-sm font-medium focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 outline-none transition dark:text-white" 
                     placeholder="••••••••">
            </div>
            <div id="passError" class="text-[10px] font-bold text-red-500 uppercase tracking-widest ml-4 mt-1"></div>
          </div>

          <div class="space-y-2">
            <label for="confirmPass" class="text-[10px] font-bold text-luxury-black dark:text-gray-400 uppercase tracking-widest ml-4">Confirm Secret Key</label>
            <div class="relative group">
              <span class="absolute left-6 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-gold-500 transition-colors">
                <i class="fa-solid fa-shield-halved text-sm"></i>
              </span>
              <input type="password" id="confirmPass" name="confirmPassword" 
                     class="w-full bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl py-4 pl-14 pr-6 text-sm font-medium focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 outline-none transition dark:text-white" 
                     placeholder="••••••••">
            </div>
            <div id="confirmError" class="text-[10px] font-bold text-red-500 uppercase tracking-widest ml-4 mt-1"></div>
          </div>

          <button type="submit" class="w-full bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl mt-4">
            Reset Identity
          </button>
        </form>

        <div class="mt-12 text-center">
          <a href="/auth/login" class="text-[10px] font-bold text-gray-400 hover:text-gold-600 dark:hover:text-gold-400 uppercase tracking-widest transition">
            Back to Login Console
          </a>
        </div>
      </div>

      <!-- Visual Side -->
      <div class="hidden md:block flex-1 relative">
        <img src="/images/blackshirtwtchperfume.avif" alt="Luxury" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-r from-white dark:from-luxury-charcoal to-transparent md:block hidden"></div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById("form");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      let valid = true;

      const pass = document.getElementById("pass").value.trim();
      const confirm = document.getElementById('confirmPass').value.trim();

      document.getElementById("passError").textContent = "";
      document.getElementById("confirmError").textContent = "";

      if (pass.length < 6) {
        document.getElementById("passError").textContent = "Key must be at least 6 characters";
        valid = false;
      }
      if (pass.length <= 0) {
        document.getElementById("passError").textContent = "New key is required";
        valid = false;
      }
      if (confirm !== pass) {
        document.getElementById("confirmError").textContent = "Identity keys do not match";
        valid = false;
      }
      if (confirm.length <= 0) {
        document.getElementById("confirmError").textContent = "Confirmation is required";
        valid = false;
      }

      if (valid) form.submit();
    });
  </script>
</body>
</html>
