<%- include("../partials/user/header.ejs") %>

<main class="bg-white min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12">
      
      <%- include("../partials/user/sidebarProfile.ejs") %>

      <!-- Profile Edit Content -->
      <div class="flex-1">
        <div class="mb-10">
          <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Edit Profile</h1>
          <p class="text-gray-500 text-sm italic">Update your personal information and preferences.</p>
        </div>

        <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-sm p-8 sm:p-12">
          <form action="/profile/edit?_method=PATCH" method="POST" enctype="multipart/form-data" class="space-y-12">
            <!-- Avatar Upload -->
            <div class="flex flex-col items-center">
              <div class="relative group">
                <div id="addImg" class="w-32 h-32 rounded-full overflow-hidden border-4 border-gray-50 bg-gray-100 cursor-pointer shadow-lg transition-transform hover:scale-105">
                  <input name="userProfile" id="userProfile" type="file" hidden accept="image/*">
                  <input name="oldImg" id="oldImg" value="<%=user.public_id%>" type="hidden">
                  
                  <% if (user.photoUrl) { %>
                    <img src="<%= user.photoUrl %>" alt="Profile" loading="lazy" class="w-full h-full object-cover">
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center bg-luxury-black text-white text-4xl font-serif">
                      <%= user.name.charAt(0) %>
                    </div>
                  <% } %>
                </div>

                <div class="absolute -bottom-2 -right-2 flex space-x-2">
                   <button type="button" id="deleteBtn" class="w-10 h-10 bg-white rounded-full shadow-lg border border-gray-100 flex items-center justify-center text-red-500 hover:bg-red-50 transition <%= user.photoUrl ? '' : 'hidden' %>">
                     <i class="fa-solid fa-trash-can text-sm"></i>
                   </button>
                   <div class="w-10 h-10 bg-gold-600 rounded-full shadow-lg flex items-center justify-center text-white pointer-events-none">
                     <i class="fa-solid fa-camera text-sm"></i>
                   </div>
                </div>
                
                <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold text-center mt-6">Click to update photo</p>
              </div>
            </div>

            <!-- Form Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="space-y-2">
                <label for="name" class="text-[10px] font-bold text-luxury-black uppercase tracking-widest ml-4">Full Name</label>
                <input type="text" id="name" name="name" value="<%=user.name%>" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-100 focus:ring-2 focus:ring-gold-500 focus:bg-white transition outline-none text-sm font-medium">
              </div>

              <div class="space-y-2">
                <label for="email" class="text-[10px] font-bold text-luxury-black uppercase tracking-widest ml-4">Email Address</label>
                <input type="email" id="email" name="email" value="<%=user.email%>" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-100 focus:ring-2 focus:ring-gold-500 focus:bg-white transition outline-none text-sm font-medium">
              </div>

              <div class="space-y-2">
                <label for="phone" class="text-[10px] font-bold text-luxury-black uppercase tracking-widest ml-4">Mobile Number</label>
                <input type="tel" pattern="[0-9]{10}" id="phone" name="phone" value="<%=user.mobile?user.mobile:''%>" placeholder="10-digit mobile number" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-100 focus:ring-2 focus:ring-gold-500 focus:bg-white transition outline-none text-sm font-medium">
              </div>

              <div class="space-y-2">
                <label class="text-[10px] font-bold text-luxury-black uppercase tracking-widest ml-4">Gender</label>
                <div class="flex space-x-4 p-1 bg-gray-50 rounded-2xl border border-gray-100">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="gender" value="female" class="peer hidden" <%=user.gender==='female' ?'checked':''%>>
                    <div class="py-3 text-center rounded-xl text-xs font-bold uppercase tracking-widest transition-all peer-checked:bg-white peer-checked:text-luxury-black peer-checked:shadow-sm text-gray-400">Female</div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="gender" value="male" class="peer hidden" <%=user.gender==='male' ?'checked':''%>>
                    <div class="py-3 text-center rounded-xl text-xs font-bold uppercase tracking-widest transition-all peer-checked:bg-white peer-checked:text-luxury-black peer-checked:shadow-sm text-gray-400">Male</div>
                  </label>
                </div>
              </div>
            </div>

            <!-- Footer Actions -->
            <div class="pt-8 border-t border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-6">
              <% if(user.password) { %>
                <a href="/profile/changePassword" class="text-[10px] font-bold text-gold-600 uppercase tracking-widest hover:text-luxury-black transition underline underline-offset-8">
                  Security & Password
                </a>
              <% } else { %>
                <div></div>
              <% } %>
              
              <button type="submit" class="w-full sm:w-auto bg-luxury-black text-white px-12 py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl">
                Save Profile Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  const addImg = document.getElementById("addImg");
  const userProfile = document.getElementById("userProfile");
  const deleteBtn = document.getElementById("deleteBtn");

  async function restorePlaceholder() {
    const public_id = document.getElementById('oldImg').value;
    
    try {
      const res = await fetch('/profile/api/deleteProfile', {
        method: 'PATCH',
        headers: { "Content-Type": 'application/json' },
        body: JSON.stringify({ public_id })
      });
      const data = await res.json();
      
      if (data.status) {
        // Reset to initial
        addImg.innerHTML = `
          <input name="userProfile" id="userProfile" type="file" hidden accept="image/*">
          <input name="oldImg" id="oldImg" value="<%=user.public_id%>" type="hidden">
          <div class="w-full h-full flex items-center justify-center bg-luxury-black text-white text-4xl font-serif">
            <%= user.name.charAt(0) %>
          </div>
        `;
        // Re-attach input event
        document.getElementById("userProfile").addEventListener("change", handleFileChange);
        deleteBtn.classList.add("hidden");
        if(typeof showAlert !== 'undefined') showAlert('success', data.message);
      }
    } catch (err) {}
  }

  function handleFileChange(e) {
    const file = e.target.files[0];
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      if(typeof showAlert !== 'undefined') showAlert("error", "Please upload a valid image file");
      e.target.value = "";
      return;
    }

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = document.createElement("img");
      img.src = event.target.result;
      img.className = "w-full h-full object-cover";
      
      // Keep inputs
      const userProfileInput = document.getElementById("userProfile");
      const oldImgInput = document.getElementById("oldImg");
      
      addImg.innerHTML = "";
      addImg.appendChild(userProfileInput);
      addImg.appendChild(oldImgInput);
      addImg.appendChild(img);

      deleteBtn.classList.remove("hidden");
    };
    reader.readAsDataURL(file);
  }

  addImg.addEventListener("click", () => document.getElementById("userProfile").click());
  document.getElementById("userProfile").addEventListener("change", handleFileChange);

  deleteBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    restorePlaceholder();
  });
</script>

<%- include("../partials/user/footer.ejs") %>
    </body>

    </html>