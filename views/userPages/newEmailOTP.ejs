<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Email | VENICARA</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/output.css" />
  <script src="https://kit.fontawesome.com/f45c5ea548.js" crossorigin="anonymous"></script>
</head>
<body class="h-full bg-luxury-cream dark:bg-luxury-black font-sans transition-colors duration-300 flex items-center justify-center p-6">

  <div class="max-w-4xl w-full bg-white dark:bg-luxury-charcoal rounded-[3rem] shadow-2xl overflow-hidden animate-zoom-in">
    <div class="flex flex-col md:flex-row flex-row-reverse">
      <!-- Form Side -->
      <div class="flex-1 p-10 md:p-16">
        <div class="mb-12">
          <img src="/images/logo.avif" alt="Venicara" class="w-40 mb-10 dark:invert">
          <h2 class="text-3xl font-serif font-bold text-luxury-black dark:text-white mb-2 uppercase tracking-tight">Identity Verification</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm italic">A secure code has been dispatched to your mailbox.</p>
        </div>

        <% if(messages.error && messages.error.length > 0){ %>
          <div class="mb-8 p-4 bg-red-50 dark:bg-red-500/10 border border-red-100 dark:border-red-500/20 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-widest rounded-2xl flex items-center">
            <i class="fa-solid fa-circle-exclamation mr-3 text-sm"></i>
            <%= messages.error[0] %>
          </div>
        <% } %>

        <form action="/profile/edit/otp" method="post" class="space-y-8">
          <div class="space-y-4">
            <label class="text-[10px] font-bold text-luxury-black dark:text-gray-400 uppercase tracking-widest ml-4 text-center block w-full">Authentication Code</label>
            <input type="text" name="otp" maxlength="6"
                   class="w-full bg-gray-50 dark:bg-luxury-black border border-gray-100 dark:border-white/5 rounded-2xl py-5 text-center text-2xl font-mono font-bold tracking-[0.5em] focus:ring-2 focus:ring-gold-500/20 focus:border-gold-500 outline-none transition dark:text-white" 
                   placeholder="000000">
            <input type="hidden" id="email" value="<%=email%>" name="email">
          </div>

          <div class="flex flex-col items-center space-y-4 pt-2">
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 flex items-center">
              <i class="fa-solid fa-clock-rotate-left mr-2 text-gold-500"></i>
              Expiry in <span id="timer" class="text-gold-600 dark:text-gold-400 ml-1">00:50s</span>
            </div>
            
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
              Identity unconfirmed? 
              <button id="resend-otp" type="button" class="text-gold-600 dark:text-gold-400 hover:underline ml-1">Dispatch Again</button>
            </p>
          </div>

          <button type="submit" class="w-full bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl">
            Confirm Identity
          </button>
        </form>

        <div class="mt-12 text-center">
          <a href="/profile/edit" class="text-[10px] font-bold text-gray-400 hover:text-gold-600 dark:hover:text-gold-400 uppercase tracking-widest transition">
            Modify Profile Settings
          </a>
        </div>
      </div>

      <!-- Visual Side -->
      <div class="hidden md:block flex-1 relative">
        <img src="/images/b&w.avif" alt="Luxury" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-l from-white dark:from-luxury-charcoal to-transparent md:block hidden"></div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const resend = document.getElementById('resend-otp');
      const timer = document.getElementById('timer');
      let timerId;

      function startTimer(seconds) {
        if (timerId) clearInterval(timerId);
        let i = seconds;

        resend.style.pointerEvents = 'none';
        resend.classList.add('opacity-50');
        timer.innerHTML = `00:${i < 10 ? '0' + i : i}s`;

        timerId = setInterval(() => {
          i--;
          timer.innerHTML = `00:${i < 10 ? '0' + i : i}s`;
          if (i <= 0) {
            clearInterval(timerId);
            timer.innerHTML = `00:00s`;
            resend.style.pointerEvents = 'auto';
            resend.classList.remove('opacity-50');
          }
        }, 1000);
      }

      resend.addEventListener('click', async (e) => {
        e.preventDefault();
        const originalText = resend.innerHTML;
        resend.innerHTML = 'Sending...';
        resend.style.pointerEvents = 'none';

        try {
          const email = document.getElementById('email').value.trim();
          const response = await fetch('/profile/resendOTP', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email })
          });

          const data = await response.json();

          if (data.success) {
            resend.innerHTML = originalText;
            startTimer(50);
          } else {
            resend.innerHTML = originalText;
            resend.style.pointerEvents = 'auto';
          }
        } catch (err) {
          resend.innerHTML = originalText;
          resend.style.pointerEvents = 'auto';
        }
      });

      startTimer(50);
    });
  </script>
</body>
</html>
