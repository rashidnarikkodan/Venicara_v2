<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=title%> | Login</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script defer src="/js/userLogin.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'luxury-black': '#121212',
            'luxury-cream': '#f8f5f0',
            'gold-600': '#d4af37',
            'gold-500': '#e5c05b',
          },
          fontFamily: {
            'serif': ['Playfair Display', 'serif'],
            'sans': ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-cream min-h-screen flex items-center justify-center p-4">
  <div class="max-w-5xl w-full bg-white rounded-[3rem] shadow-2xl overflow-hidden flex flex-col lg:flex-row">
    
    <!-- Left: Artistic Branding Section -->
    <div class="lg:w-1/2 relative bg-luxury-black hidden lg:block">
      <img src="/images/login.avif" alt="Venicara Luxury" class="w-full h-full object-cover opacity-80">
      <div class="absolute inset-0 bg-gradient-to-t from-luxury-black via-transparent to-transparent"></div>
      <div class="absolute bottom-12 left-12 right-12">
         <img src="/images/logo.avif" class="w-48 mb-8 brightness-0 invert" alt="Venicara">
         <h2 class="text-4xl font-serif font-bold text-white mb-4 leading-tight">Elevate Your Senses</h2>
         <p class="text-gray-400 text-sm italic">"The final touch of luxury is a fragrance that tells your story."</p>
      </div>
    </div>

    <!-- Right: Login Form Section -->
    <div class="flex-1 p-8 sm:p-12 lg:p-16">
      <div class="mb-10 text-center lg:text-left">
        <div class="lg:hidden flex justify-center mb-8">
           <img src="/images/logo.avif" class="w-40" alt="Venicara">
        </div>
        <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Welcome Back</h1>
        <p class="text-gray-500 text-sm italic">Enter your credentials to access your private collection.</p>
      </div>

      <% if(messages.success && messages.success.length > 0) { %>
        <div class="mb-8 p-4 bg-green-50 border border-green-100 text-green-600 text-[10px] font-bold uppercase tracking-widest rounded-2xl flex items-center shadow-sm">
          <i class="fa-solid fa-circle-check mr-3"></i>
          <%= messages.success[0] %>
        </div>
      <% } %>

      <% if(messages.error && messages.error.length > 0) { %>
        <div class="mb-8 p-4 bg-red-50 border border-red-100 text-red-600 text-[10px] font-bold uppercase tracking-widest rounded-2xl flex items-center shadow-sm">
          <i class="fa-solid fa-circle-exclamation mr-3"></i>
          <%= messages.error[0] %>
        </div>
      <% } %>

      <div class="space-y-6">
        <!-- Google Login -->
        <a href="/auth/google" class="flex items-center justify-center space-x-3 w-full py-4 rounded-full border border-gray-100 bg-white hover:bg-gray-50 transition shadow-sm text-sm font-bold text-luxury-black uppercase tracking-widest group">
          <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" class="w-5">
          <span>Continue with Google</span>
        </a>

        <div class="relative flex items-center py-4">
          <div class="flex-grow border-t border-gray-100"></div>
          <span class="flex-shrink mx-4 text-[10px] font-bold text-gray-400 uppercase tracking-[0.3em]">Or use email</span>
          <div class="flex-grow border-t border-gray-100"></div>
        </div>

        <form action="/auth/login" method="post" id="form" class="space-y-6">
          <div class="space-y-2">
            <label class="text-[10px] font-bold text-luxury-black uppercase tracking-widest ml-4">Email Address</label>
            <input type="email" id="email" name="email" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-transparent focus:bg-white focus:ring-2 focus:ring-gold-500 focus:border-transparent transition outline-none text-sm font-medium" placeholder="your@email.com">
            <div id="emailError" class="text-[9px] text-red-500 font-bold uppercase tracking-widest mt-1 ml-4"></div>
          </div>

          <div class="space-y-2">
            <div class="flex justify-between items-center px-4">
               <label class="text-[10px] font-bold text-luxury-black uppercase tracking-widest">Password</label>
               <a href="/auth/forgot" class="text-[9px] font-bold text-gold-600 uppercase tracking-widest hover:text-luxury-black transition">Forgot?</a>
            </div>
            <input type="password" id="pass" name="password" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-transparent focus:bg-white focus:ring-2 focus:ring-gold-500 focus:border-transparent transition outline-none text-sm font-medium" placeholder="••••••••">
            <div id="passError" class="text-[9px] text-red-500 font-bold uppercase tracking-widest mt-1 ml-4"></div>
          </div>

          <button type="submit" class="w-full bg-luxury-black text-white py-5 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl mt-4 group">
            <span>Login to Account</span>
            <i class="fa-solid fa-arrow-right ml-3 group-hover:translate-x-1 transition-transform"></i>
          </button>
        </form>

        <div class="mt-12 text-center">
           <p class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-4">New to Venicara?</p>
           <a href="/auth/signup" class="text-luxury-black font-bold uppercase tracking-widest text-[11px] hover:text-gold-600 transition underline underline-offset-8 decoration-gold-400/30">Create an Account</a>
        </div>
      </div>
      
      <div class="mt-12 pt-8 border-t border-gray-50 text-center">
         <a href="/" class="text-[10px] font-bold text-gray-400 hover:text-luxury-black uppercase tracking-widest transition">
           <i class="fa-solid fa-house mr-2"></i> Back to Home
         </a>
      </div>
    </div>
  </div>
</body>
</html>
