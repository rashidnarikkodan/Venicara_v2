<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VENICARA | Verify OTP</title>
  <link rel="shortcut icon" href="/images/fevicon.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script defer src="/js/signupOTP.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'luxury-black': '#121212',
            'luxury-cream': '#f8f5f0',
            'gold-600': '#d4af37',
            'gold-500': '#e5c05b',
          },
          fontFamily: {
            'serif': ['Playfair Display', 'serif'],
            'sans': ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="bg-luxury-black min-h-screen flex items-center justify-center p-4">
  <div class="max-w-2xl w-full bg-white rounded-[3rem] shadow-2xl overflow-hidden p-8 sm:p-12 lg:p-16 relative">
    <!-- Luxury Accents -->
    <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-gold-400 via-gold-600 to-gold-400"></div>
    
    <div class="text-center mb-12">
      <img src="/images/logo.avif" class="w-48 mx-auto mb-10" alt="Venicara">
      <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Email Verification</h1>
      <p class="text-gray-500 text-sm italic">Unlock your access to artisanal fragrances.</p>
    </div>

    <% if(messages.success && messages.success.length > 0) { %>
      <div class="mb-8 p-4 bg-green-50 border border-green-100 text-green-600 text-[10px] font-bold uppercase tracking-widest rounded-2xl flex items-center justify-center shadow-sm">
        <i class="fa-solid fa-circle-check mr-3"></i>
        <%= messages.success[0] %>
      </div>
    <% } %>

    <% if(messages.error && messages.error.length > 0) { %>
      <div class="mb-8 p-4 bg-red-50 border border-red-100 text-red-600 text-[10px] font-bold uppercase tracking-widest rounded-2xl flex items-center justify-center shadow-sm">
        <i class="fa-solid fa-circle-exclamation mr-3"></i>
        <%= messages.error[0] %>
      </div>
    <% } %>

    <form action="/auth/signup/verify-otp" method="post" class="space-y-10">
      <div class="space-y-6">
        <input type="text" name="otp" placeholder="XXXXXX" class="w-full text-center text-4xl font-bold tracking-[0.5em] px-6 py-6 rounded-3xl bg-gray-50 border border-transparent focus:bg-white focus:ring-2 focus:ring-gold-500 transition outline-none text-luxury-black" maxlength="6">
        
        <div class="flex flex-col items-center space-y-4">
           <div class="flex items-center space-x-2 text-xs font-bold uppercase tracking-widest">
             <span class="text-gray-400">Expiring in</span>
             <span id="timer" class="text-gold-600">00:50s</span>
           </div>
           
           <div class="text-[10px] font-bold uppercase tracking-widest">
              <span class="text-gray-400">Didn't receive code?</span>
              <a href="#" id="resend-otp" class="text-gold-600 hover:text-luxury-black transition ml-2 border-b border-gold-600/30">Resend Now</a>
           </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-luxury-black text-white py-6 rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-gold-600 transition shadow-xl group">
        <span>Verify & Create Account</span>
        <i class="fa-solid fa-shield-check ml-3 group-hover:scale-110 transition-transform"></i>
      </button>
    </form>

    <div class="mt-12 text-center pt-8 border-t border-gray-50">
      <a href="/auth/signup" class="text-[10px] font-bold text-gray-400 hover:text-luxury-black uppercase tracking-widest transition">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Signup
      </a>
    </div>
  </div>
</body>
</html>
