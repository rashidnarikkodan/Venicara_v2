<%- include("../partials/user/header.ejs") %>

<main class="bg-luxury-cream dark:bg-luxury-black min-h-screen transition-colors duration-300">
  <!-- Hero Section -->
  <section class="relative py-24 md:py-32 overflow-hidden border-b border-gray-100 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="text-gold-600 dark:text-gold-400 text-xs font-bold uppercase tracking-[0.4em] mb-4 inline-block">Haute Parfumerie</span>
      <h1 class="text-4xl md:text-6xl font-serif font-bold text-luxury-black dark:text-white tracking-tight mb-8">
        Crafting Memories <br class="hidden sm:inline" />
        <span class="italic font-normal text-gold-600 dark:text-gold-400">Through Scent</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-600 dark:text-gray-300 text-base md:text-lg leading-relaxed font-light">
        Born from an obsession with rare botanicals and timeless elegance, Venicara creates olfactory masterpieces that linger in memory long after you have left the room.
      </p>
    </div>
  </section>

  <!-- Story Pillars -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center mb-24">
      <div class="space-y-6">
        <span class="text-gold-600 dark:text-gold-400 text-xs font-bold uppercase tracking-widest">Our Heritage</span>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-luxury-black dark:text-white">The Genesis of Elegance</h2>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
          Founded with a devotion to artisanal perfumery, Venicara bridges historical extraction techniques with contemporary olfactory artistry. Every formulation begins in our partner ateliers in Grasse, France, where master perfumers meticulously balance top, heart, and base notes over months of maceration.
        </p>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
          We believe true luxury resides in patience: letting natural absolutes mature to peak potency before hand-pouring into our signature flacons.
        </p>
      </div>
      <div class="bg-gradient-to-br from-gold-500/10 via-transparent to-luxury-black/10 rounded-3xl p-8 border border-gray-100 dark:border-white/5 shadow-2xl">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-luxury-charcoal flex items-center justify-center text-center p-8">
          <div>
            <i class="fa-solid fa-gem text-5xl text-gold-500 mb-4"></i>
            <h3 class="text-2xl font-serif font-bold text-white mb-2">Uncompromising Ingredients</h3>
            <p class="text-gray-400 text-xs tracking-wider uppercase">Sourced ethically from across 18 countries</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Values Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-3xl border border-gray-100 dark:border-white/5 hover:border-gold-500/30 transition-all duration-300 group">
        <div class="w-14 h-14 rounded-2xl bg-gold-50 dark:bg-gold-500/10 flex items-center justify-center text-gold-600 dark:text-gold-400 text-2xl mb-8 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-feather"></i>
        </div>
        <h3 class="text-lg font-bold text-luxury-black dark:text-white mb-3">Artisanal Extraction</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
          Cold-pressed citrus, steam-distilled woods, and solvent-free resin extraction protect the volatile heart of each botanical.
        </p>
      </div>

      <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-3xl border border-gray-100 dark:border-white/5 hover:border-gold-500/30 transition-all duration-300 group">
        <div class="w-14 h-14 rounded-2xl bg-gold-50 dark:bg-gold-500/10 flex items-center justify-center text-gold-600 dark:text-gold-400 text-2xl mb-8 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-clock"></i>
        </div>
        <h3 class="text-lg font-bold text-luxury-black dark:text-white mb-3">Exceptional Longevity</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
          High concentration Extrait de Parfum and Eau de Parfum concentrations ensuring 12+ hours of magnetic sillage.
        </p>
      </div>

      <div class="bg-white dark:bg-luxury-charcoal p-10 rounded-3xl border border-gray-100 dark:border-white/5 hover:border-gold-500/30 transition-all duration-300 group">
        <div class="w-14 h-14 rounded-2xl bg-gold-50 dark:bg-gold-500/10 flex items-center justify-center text-gold-600 dark:text-gold-400 text-2xl mb-8 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-leaf"></i>
        </div>
        <h3 class="text-lg font-bold text-luxury-black dark:text-white mb-3">Ethical Luxury</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
          100% cruelty-free, recyclable luxury glass packaging, and fair-trade agreements with family-owned blossom farms.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 text-center">
    <div class="bg-luxury-black dark:bg-luxury-charcoal rounded-[3rem] p-12 md:p-20 text-white relative overflow-hidden border border-gold-500/20">
      <div class="relative z-10 max-w-2xl mx-auto space-y-8">
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-gold-400">Discover Your Signature</h2>
        <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed">
          Explore our private collection of niche perfumes curated for connoisseurs of distinction.
        </p>
        <a href="/shop" class="inline-block bg-gold-500 hover:bg-gold-600 text-black px-10 py-4 rounded-full font-bold text-xs uppercase tracking-[0.2em] transition duration-300 shadow-xl">
          Shop The Collection
        </a>
      </div>
    </div>
  </section>
</main>

<%- include("../partials/user/footer.ejs") %>
