                <i class="fa-brands fa-instagram text-xl"></i>
              </a>
              <a href="https://wa.me/919745239794" target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-2xl bg-gray-50 dark:bg-luxury-black flex items-center justify-center text-green-600 dark:text-green-400 hover:text-green-500 transition border border-gray-100 dark:border-white/5 shadow-sm" title="WhatsApp">
