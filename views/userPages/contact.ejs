            <div class="flex items-center space-x-4">
              <a href="https://github.com/rashidnarikkodan" target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-2xl bg-gray-50 dark:bg-luxury-black flex items-center justify-center text-gray-600 dark:text-gray-400 hover:text-gold-600 dark:hover:text-gold-400 transition border border-gray-100 dark:border-white/5 shadow-sm" title="GitHub">
