<%- include("../partials/user/header.ejs") %>

<main class="bg-white min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12">
      
      <%- include("../partials/user/sidebarProfile.ejs") %>

      <!-- Wallet Content -->
      <div class="flex-1">
        <div class="mb-10">
          <h1 class="text-3xl font-serif font-bold text-luxury-black mb-2 uppercase tracking-tight">Venicara Wallet</h1>
          <p class="text-gray-500 text-sm italic">Manage your credits and view your transaction journey.</p>
        </div>

        <!-- Wallet Card -->
        <div class="relative overflow-hidden rounded-[2.5rem] bg-luxury-black p-8 sm:p-12 mb-12 shadow-2xl group transition-all duration-500 hover:shadow-gold-600/10">
          <!-- Decorative Background Elements -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-gold-600/10 rounded-full blur-3xl -mr-32 -mt-32"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full blur-2xl -ml-24 -mb-24"></div>
          
          <div class="relative z-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-12">
            <div class="space-y-4">
              <p class="text-[10px] text-gold-400 font-bold uppercase tracking-[0.3em]">Available Balance</p>
              <h2 class="text-5xl sm:text-6xl font-serif font-bold text-white tracking-tighter">
                <span class="text-2xl text-gold-500 mr-2">Rs.</span><span id="balanceDisplay"><%=(wallet?.balance).toFixed(2)%></span>
              </h2>
              <div class="pt-4 flex items-center space-x-4">
                 <div class="flex -space-x-2">
                    <div class="w-8 h-8 rounded-full border-2 border-luxury-black bg-gray-800"></div>
                    <div class="w-8 h-8 rounded-full border-2 border-luxury-black bg-gray-700"></div>
                    <div class="w-8 h-8 rounded-full border-2 border-luxury-black bg-gold-600 flex items-center justify-center text-[10px] text-white font-bold">V</div>
                 </div>
                 <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">Premium Member</p>
              </div>
            </div>

            <!-- Add Money Section -->
            <div class="w-full sm:w-auto bg-white/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 space-y-6">
              <p class="text-[10px] text-gold-400 font-bold uppercase tracking-widest">Recharge Wallet</p>
              
              <form id="walletForm" class="space-y-6">
                <div class="relative group">
                   <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gold-500 font-serif font-bold text-xl">Rs.</span>
                   <input type="text" id="amount" class="w-full bg-white/10 border border-white/20 rounded-2xl py-4 pl-12 pr-4 text-white text-xl font-serif font-bold focus:ring-gold-500 focus:border-gold-500 outline-none transition" value="0" maxlength="10">
                </div>

                <div class="flex gap-2">
                  <button type="button" class="preset-btn flex-1 py-3 rounded-xl bg-white/5 border border-white/10 text-[10px] text-white font-bold hover:bg-gold-600 hover:border-gold-600 transition" data-value="100">100</button>
                  <button type="button" class="preset-btn flex-1 py-3 rounded-xl bg-white/5 border border-white/10 text-[10px] text-white font-bold hover:bg-gold-600 hover:border-gold-600 transition" data-value="500">500</button>
                  <button type="button" class="preset-btn flex-1 py-3 rounded-xl bg-white/5 border border-white/10 text-[10px] text-white font-bold hover:bg-gold-600 hover:border-gold-600 transition" data-value="1000">1000</button>
                </div>

                <button type="submit" class="w-full bg-gold-600 text-white py-4 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-gold-500 transition shadow-xl flex items-center justify-center group">
                  <span>Add Money</span>
                  <i class="fa-solid fa-arrow-right ml-3 group-hover:translate-x-1 transition-transform"></i>
                </button>
              </form>
            </div>
          </div>
        </div>

        <!-- History Link -->
        <div class="flex justify-between items-center mb-8">
           <h3 class="text-xl font-serif font-bold text-luxury-black tracking-tight">Recent Activity</h3>
           <a href="/wallet/history" class="text-[10px] font-bold text-gold-600 uppercase tracking-widest hover:text-gold-700 transition underline underline-offset-8 decoration-gold-600/30">View Full History</a>
        </div>

        <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-12 text-center bg-gray-50/30">
           <i class="fa-solid fa-clock-rotate-left text-4xl text-gray-200 mb-4"></i>
           <p class="text-gray-400 text-xs uppercase tracking-[0.2em] font-bold">Detailed Transaction History is available on the history page.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Modal (Custom Tailwind version) -->
  <div id="statusModal" class="fixed inset-0 z-[110] hidden flex items-center justify-center p-4">
    <div id="statusModalOverlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <div id="statusModalContent" class="relative bg-white rounded-[2.5rem] p-10 max-w-sm w-full shadow-2xl text-center transform scale-95 opacity-0 transition-all duration-300">
      <div id="statusModalIcon" class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8">
        <i class="fa-solid text-3xl"></i>
      </div>
      <h2 id="statusModalTitle" class="text-2xl font-serif font-bold text-luxury-black mb-4 tracking-tight uppercase"></h2>
      <p id="statusModalMessage" class="text-gray-500 text-sm mb-10 leading-relaxed"></p>
      <button onclick="hideStatusModal()" id="statusModalBtn" class="w-full py-4 rounded-full font-bold text-[10px] uppercase tracking-widest transition shadow-lg"></button>
    </div>
  </div>
</main>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  // Formatting Input
  const amountInput = document.getElementById("amount");
  amountInput.addEventListener("focus", () => { if(amountInput.value === "0") amountInput.value = ""; });
  amountInput.addEventListener("blur", () => { if(amountInput.value === "") amountInput.value = "0"; });
  amountInput.addEventListener("input", (e) => {
    e.target.value = e.target.value.replace(/[^0-9]/g, "");
  });

  // Preset Buttons
  document.querySelectorAll(".preset-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      amountInput.value = btn.dataset.value;
    });
  });

  // Modal Handlers
  function showStatusModal(type, title, message) {
    const modal = document.getElementById('statusModal');
    const overlay = document.getElementById('statusModalOverlay');
    const content = document.getElementById('statusModalContent');
    const icon = document.getElementById('statusModalIcon');
    const titleEl = document.getElementById('statusModalTitle');
    const messageEl = document.getElementById('statusModalMessage');
    const btn = document.getElementById('statusModalBtn');

    titleEl.textContent = title;
    messageEl.textContent = message;

    if (type === 'success') {
      icon.className = "w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-8";
      icon.innerHTML = '<i class="fa-solid fa-circle-check text-3xl"></i>';
      btn.className = "w-full py-4 bg-green-500 text-white rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-green-600 transition shadow-lg";
      btn.textContent = "Great, Thanks!";
      btn.onclick = () => location.reload();
    } else {
      icon.className = "w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-8";
      icon.innerHTML = '<i class="fa-solid fa-circle-xmark text-3xl"></i>';
      btn.className = "w-full py-4 bg-red-500 text-white rounded-full font-bold text-[10px] uppercase tracking-widest hover:bg-red-600 transition shadow-lg";
      btn.textContent = "Try Again";
      btn.onclick = hideStatusModal;
    }

    modal.classList.remove('hidden');
    setTimeout(() => {
      overlay.classList.remove('opacity-0');
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function hideStatusModal() {
    const modal = document.getElementById('statusModal');
    const overlay = document.getElementById('statusModalOverlay');
    const content = document.getElementById('statusModalContent');

    overlay.classList.add('opacity-0');
    content.classList.add('scale-95', 'opacity-0');
    content.classList.remove('scale-100', 'opacity-100');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }

  // Razorpay Logic
  async function createRazorpayOrder(amountValue) {
    try {
      const res = await fetch("/wallet/add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount: amountValue }),
      });
      const data = await res.json();
      return data.order;
    } catch (err) {
      showStatusModal('error', 'Order Error', 'Could not initiate the recharge. Please try again.');
      return null;
    }
  }

  async function verifyPayment(response) {
    try {
      const res = await fetch("/wallet/verify-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(response),
      });
      const data = await res.json();
      if (data.status) {
        document.getElementById("balanceDisplay").textContent = data.balance.toFixed(2);
        showStatusModal('success', 'Recharge Success', 'Your Venicara Wallet has been credited successfully.');
      } else {
        showStatusModal('error', 'Verification Failed', data.message || 'Payment verification failed.');
      }
    } catch (err) {
      showStatusModal('error', 'Error', 'Something went wrong during verification.');
    }
  }

  document.getElementById("walletForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const amountValue = amountInput.value.trim();
    if (!amountValue || isNaN(amountValue) || parseInt(amountValue) <= 0) {
      showStatusModal('error', 'Invalid Amount', 'Please enter a valid amount to recharge.');
      return;
    }

    const order = await createRazorpayOrder(amountValue);
    if (!order) return;

    const options = {
      key: "<%= process.env.RAZORPAY_KEY_ID %>",
      amount: order.amount,
      currency: "INR",
      name: "Venicara Wallet",
      description: "Wallet Top-up",
      order_id: order.id,
      handler: verifyPayment,
      theme: { color: "#d4af37" },
      modal: {
        ondismiss: async () => {
          try {
            await fetch('/wallet/api/addMoneyFailed', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ razorpayId: order.id })
            });
            showStatusModal('error', 'Payment Cancelled', 'The transaction was cancelled.');
          } catch(e) {}
        }
      }
    };
    const rzp = new Razorpay(options);
    rzp.open();
  });
</script>

<%- include("../partials/user/footer.ejs") %>

</body>
</html>
