<% if(user){ %>
  <%- include("../partials/user/header.ejs") %>
<% } else { %>
  <%- include("../partials/user/header-landing.ejs") %>
<% } %>

<main class="bg-white dark:bg-luxury-black min-h-screen transition-colors duration-300">
  <!-- Page Header -->
  <div class="bg-luxury-cream dark:bg-luxury-charcoal py-16 border-b border-gray-100 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-luxury-black dark:text-white mb-4">All Fragrances</h1>
      <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto italic">Explore our curated collection of artisanal scents, from fresh florals to deep oriental masterpieces.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row gap-12">
      
      <!-- Desktop Sidebar Filter -->
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="sticky top-24">
          <div class="flex justify-between items-center mb-8">
            <h3 class="text-lg font-bold tracking-tight dark:text-white">Filters</h3>
            <a href="/shop" class="text-xs font-bold text-gold-600 dark:text-gold-400 hover:text-gold-700 uppercase tracking-widest">Clear All</a>
          </div>

          <form action="/shop" class="space-y-10">
            <!-- Search (Hidden but preserved for form submission) -->
            <% if(search && search.length > 0) { %>
              <input type="hidden" name="search" value="<%= search %>">
            <% } %>

            <!-- Categories -->
            <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 dark:border-white/5 pb-2 dark:text-gray-300">Category</h4>
              <div class="space-y-3">
                <div class="flex items-center">
                  <input id="cat-all" name="category" value="all" type="radio" class="h-4 w-4 border-gray-300 dark:border-white/20 bg-transparent text-gold-600 focus:ring-gold-500" <%= !selectedCategory || selectedCategory === 'all' ? 'checked' : '' %>>
                  <label for="cat-all" class="ml-3 text-sm text-gray-600 dark:text-gray-400 cursor-pointer">All Categories</label>
                </div>
                <% categories.forEach(category => { %>
                  <div class="flex items-center">
                    <input id="cat-<%= category._id %>" name="category" value="<%= category._id %>" type="radio" class="h-4 w-4 border-gray-300 dark:border-white/20 bg-transparent text-gold-600 focus:ring-gold-500" <%= selectedCategory && selectedCategory.toString() === category._id.toString() ? 'checked' : '' %>>
                    <label for="cat-<%= category._id %>" class="ml-3 text-sm text-gray-600 dark:text-gray-400 cursor-pointer"><%= category.name %></label>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Price Range -->
            <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 dark:border-white/5 pb-2 dark:text-gray-300">Price Range</h4>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="sr-only">Min Price</label>
                  <input type="number" name="minPrice" value="<%= minPrice %>" placeholder="Min" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-white/10 bg-white dark:bg-luxury-charcoal rounded-md focus:ring-gold-500 focus:border-gold-500 dark:text-white">
                </div>
                <div>
                  <label class="sr-only">Max Price</label>
                  <input type="number" name="maxPrice" value="<%= maxPrice %>" placeholder="Max" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-white/10 bg-white dark:bg-luxury-charcoal rounded-md focus:ring-gold-500 focus:border-gold-500 dark:text-white">
                </div>
              </div>
            </div>

            <!-- Sorting -->
            <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 dark:border-white/5 pb-2 dark:text-gray-300">Sort By</h4>
              <select name="sort" class="w-full bg-white dark:bg-luxury-charcoal border border-gray-200 dark:border-white/10 text-sm px-3 py-2 rounded-md focus:ring-gold-500 focus:border-gold-500 outline-none dark:text-white">
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest Arrivals</option>
                <option value="asc" <%= sort === 'asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="desc" <%= sort === 'desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="az" <%= sort === 'az' ? 'selected' : '' %>>Name: A to Z</option>
                <option value="za" <%= sort === 'za' ? 'selected' : '' %>>Name: Z to A</option>
              </select>
            </div>

            <button type="submit" class="w-full bg-luxury-black text-white py-3 rounded-md font-bold text-xs uppercase tracking-widest hover:bg-gold-600 transition duration-300 shadow-lg">
              Apply Filters
            </button>
          </form>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="flex-1">
        <!-- Mobile Filter Button -->
        <div class="lg:hidden flex justify-between items-center mb-8 p-4 bg-luxury-cream dark:bg-luxury-charcoal rounded-xl">
          <span class="text-sm font-bold uppercase tracking-widest dark:text-gray-300">Showing <%= products.length %> products</span>
          <button id="openMobileFilters" class="flex items-center text-sm font-bold uppercase tracking-widest text-gold-600 dark:text-gold-400">
            <i class="fa-solid fa-sliders mr-2"></i> Filters
          </button>
        </div>

        <!-- Desktop Stats -->
        <div class="hidden lg:flex justify-between items-center mb-10">
          <p class="text-sm text-gray-500 italic dark:text-gray-400">Showing <%= (currentPage-1)*limit + 1 %>-<%= Math.min(currentPage*limit, totalProducts || products.length) %> of <%= totalProducts || products.length %> results</p>
          <div class="flex items-center space-x-2">
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500">View:</span>
            <button class="w-8 h-8 flex items-center justify-center text-luxury-black dark:text-white border border-gray-200 dark:border-white/10 rounded"><i class="fa-solid fa-table-cells"></i></button>
          </div>
        </div>

        <!-- Product Grid -->
        <% if(products.length === 0) { %>
          <div class="py-20 text-center">
            <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-300">
              <i class="fa-solid fa-magnifying-glass text-3xl"></i>
            </div>
            <h3 class="text-xl font-serif font-bold mb-2 text-luxury-black">No fragrances found</h3>
            <p class="text-gray-500 mb-8">Try adjusting your filters or search terms.</p>
            <a href="/shop" class="inline-block px-8 py-3 bg-luxury-black text-white rounded-full text-xs font-bold uppercase tracking-widest hover:bg-gold-600 transition">Clear All Filters</a>
          </div>
        <% } else { %>
          <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-3 gap-x-6 gap-y-12">
            <% products.forEach(product => { %>
              <%- include('../partials/user/productCard.ejs', { product: product, wishlistIds: wishlistIds }) %>
            <% }) %>
          </div>
        <% } %>

        <!-- Pagination -->
        <% if(totalPages > 1) { %>
          <div class="mt-20 border-t border-gray-100 pt-10 flex justify-center">
            <nav class="flex items-center space-x-2">
              <% if (currentPage > 1) { %>
                <a href="?<%= buildQuery({ page: currentPage - 1, limit }) %>" class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 hover:border-gold-500 hover:text-gold-600 transition">
                  <i class="fa-solid fa-chevron-left text-xs"></i>
                </a>
              <% } %>

              <% for(let i=1; i<=totalPages; i++) { %>
                <% if(i === currentPage) { %>
                  <span class="w-10 h-10 flex items-center justify-center rounded-full bg-luxury-black text-white font-bold text-sm"><%= i %></span>
                <% } else if(i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                  <a href="?<%= buildQuery({ page: i, limit }) %>" class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 hover:border-gold-500 hover:text-gold-600 transition text-sm"><%= i %></a>
                <% } else if(i === 2 || i === totalPages - 1) { %>
                  <span class="text-gray-400">...</span>
                <% } %>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="?<%= buildQuery({ page: currentPage + 1, limit }) %>" class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 hover:border-gold-500 hover:text-gold-600 transition">
                  <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
              <% } %>
            </nav>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Mobile Filter Slide-over -->
<div id="mobileFilterMenu" class="fixed inset-0 z-[100] hidden overflow-hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0" id="mobileFilterOverlay"></div>
  <div class="fixed inset-y-0 right-0 pl-10 max-w-full flex">
    <div class="w-screen max-w-md transform translate-x-full transition-transform duration-500 ease-in-out" id="mobileFilterContent">
      <div class="h-full flex flex-col bg-white shadow-2xl">
        <div class="flex items-center justify-between px-6 py-6 border-b border-gray-100">
          <h2 class="text-lg font-bold tracking-tight text-luxury-black">Filters & Sort</h2>
          <button id="closeMobileFilters" class="text-gray-400 hover:text-luxury-black">
            <i class="fa-solid fa-xmark text-2xl"></i>
          </button>
        </div>
        
        <div class="flex-1 overflow-y-auto p-6">
          <form action="/shop" id="mobileFilterForm" class="space-y-10">
             <!-- Categories (Mobile) -->
             <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 pb-2 text-gold-600">Category</h4>
              <div class="space-y-4">
                <div class="flex items-center">
                  <input id="m-cat-all" name="category" value="all" type="radio" class="h-5 w-5 border-gray-300 text-gold-600 focus:ring-gold-500" <%= !selectedCategory || selectedCategory === 'all' ? 'checked' : '' %>>
                  <label for="m-cat-all" class="ml-4 text-base text-gray-700">All Categories</label>
                </div>
                <% categories.forEach(category => { %>
                  <div class="flex items-center">
                    <input id="m-cat-<%= category._id %>" name="category" value="<%= category._id %>" type="radio" class="h-5 w-5 border-gray-300 text-gold-600 focus:ring-gold-500" <%= selectedCategory && selectedCategory.toString() === category._id.toString() ? 'checked' : '' %>>
                    <label for="m-cat-<%= category._id %>" class="ml-4 text-base text-gray-700"><%= category.name %></label>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Price (Mobile) -->
            <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 pb-2 text-gold-600">Price Range</h4>
              <div class="grid grid-cols-2 gap-6">
                <input type="number" name="minPrice" value="<%= minPrice %>" placeholder="Min" class="w-full px-4 py-3 text-sm border border-gray-200 rounded-lg">
                <input type="number" name="maxPrice" value="<%= maxPrice %>" placeholder="Max" class="w-full px-4 py-3 text-sm border border-gray-200 rounded-lg">
              </div>
            </div>

             <!-- Sorting (Mobile) -->
             <div>
              <h4 class="text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-100 pb-2 text-gold-600">Sort By</h4>
              <select name="sort" class="w-full bg-gray-50 border border-gray-200 px-4 py-3 rounded-lg outline-none">
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest Arrivals</option>
                <option value="asc" <%= sort === 'asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="desc" <%= sort === 'desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="az" <%= sort === 'az' ? 'selected' : '' %>>Name: A to Z</option>
                <option value="za" <%= sort === 'za' ? 'selected' : '' %>>Name: Z to A</option>
              </select>
            </div>
          </form>
        </div>

        <div class="p-6 border-t border-gray-100 bg-gray-50">
          <button type="submit" form="mobileFilterForm" class="w-full bg-luxury-black text-white py-4 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-gold-600 transition">
            Apply Filters
          </button>
          <a href="/shop" class="block text-center mt-4 text-xs font-bold uppercase tracking-widest text-gray-500">Reset All</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile Filter Logic
  const mobileMenu = document.getElementById('mobileFilterMenu');
  const mobileContent = document.getElementById('mobileFilterContent');
  const mobileOverlay = document.getElementById('mobileFilterOverlay');
  const openBtn = document.getElementById('openMobileFilters');
  const closeBtn = document.getElementById('closeMobileFilters');

  function openFilters() {
    mobileMenu.classList.remove('hidden');
    setTimeout(() => {
      mobileOverlay.classList.remove('opacity-0');
      mobileContent.classList.remove('translate-x-full');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeFilters() {
    mobileOverlay.classList.add('opacity-0');
    mobileContent.classList.add('translate-x-full');
    setTimeout(() => {
      mobileMenu.classList.add('hidden');
      document.body.style.overflow = '';
    }, 500);
  }

  openBtn?.addEventListener('click', openFilters);
  closeBtn?.addEventListener('click', closeFilters);
  mobileOverlay?.addEventListener('click', closeFilters);

  // Wishlist Logic (Shared)
  document.addEventListener("click", async (e) => {
    const btn = e.target.closest(".wishlist-btn");
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

    const icon = btn.querySelector("i");
    const productId = btn.dataset.productId;
    const variantId = btn.dataset.variantId;

    try {
      const res = await fetch(`/wishlist/api/add/${productId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ variantId }),
      });

      const data = await res.json();

      if (data.status) {
        icon.classList.toggle("fa-regular");
        icon.classList.toggle("fa-solid");
        icon.classList.toggle("text-gold-500");
      } else {
        if(typeof Notyf !== 'undefined') {
          new Notyf().error(data.message || "Something went wrong");
        } else {
          alert(data.message);
        }
      }
    } catch (err) {
      console.error("Wishlist error:", err);
    }
  });
</script>

<%- include('../partials/user/footer.ejs') %>