<%- include("../partials/user/header.ejs") %>

<main class="bg-white min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
       <h1 class="text-4xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-[0.2em]">Wishlist</h1>
       <p class="text-gray-500 italic text-sm">Time to fulfill your deepest desires.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10" id="wishlist-container">
      <% if(items && items.length) { %>
        <% items.forEach(item => { %>
          <div class="wishlist-item group relative bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden hover:shadow-2xl transition-all duration-500 flex flex-col h-full" data-id="<%= item._id %>">
            <!-- Product Image -->
            <div class="relative aspect-[3/4] overflow-hidden bg-gray-50">
              <img src="<%= item.product.images[0]?.url %>" alt="<%= item.product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
              
              <!-- Remove Action -->
              <button class="remove-btn absolute top-6 right-6 w-12 h-12 bg-white/90 backdrop-blur-md rounded-full flex items-center justify-center text-red-500 hover:bg-red-500 hover:text-white transition shadow-xl z-10 border border-gray-100">
                <i class="fa-solid fa-heart-crack text-sm"></i>
              </button>

              <!-- Overlay Action -->
              <div class="absolute inset-x-0 bottom-0 p-6 translate-y-full group-hover:translate-y-0 transition duration-500">
                 <button class="add-cart-btn w-full bg-luxury-black/95 backdrop-blur-md text-white py-5 rounded-[1.5rem] text-[10px] font-bold uppercase tracking-widest flex items-center justify-center hover:bg-gold-600 transition shadow-2xl">
                   <i class="fa-solid fa-cart-plus mr-3"></i> Add To Cart
                 </button>
              </div>
            </div>

            <!-- Product Info -->
            <div class="p-8 flex flex-col flex-1">
              <div class="mb-6">
                <p class="text-[10px] text-gold-600 font-bold uppercase tracking-[0.2em] mb-2">Venicara Exclusive</p>
                <h3 class="text-xl font-serif font-bold text-luxury-black uppercase tracking-tight line-clamp-1"><%= item.product.name %></h3>
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-2 flex items-center">
                  <i class="fa-solid fa-flask-vial mr-2 text-gold-500/50"></i>
                  <%= item.variant?.volume || "N/A" %> ML
                </p>
              </div>
              
              <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-50">
                <div class="space-y-1">
                  <p class="text-[9px] text-gray-400 uppercase tracking-widest font-bold">Current Price</p>
                  <p class="text-xl font-bold text-luxury-black tracking-tighter">Rs.<%= item.variant?.finalAmount.toLocaleString() %></p>
                </div>
                <a href="/products/<%=item.product._id%>" class="w-10 h-10 rounded-full border border-gray-100 flex items-center justify-center text-luxury-black hover:bg-luxury-black hover:text-white transition shadow-sm group/link">
                   <i class="fa-solid fa-arrow-right text-xs group-hover/link:translate-x-0.5 transition-transform"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-32 text-center">
          <div class="w-24 h-24 bg-luxury-cream rounded-full flex items-center justify-center mx-auto mb-8 text-gold-200 shadow-inner">
            <i class="fa-solid fa-heart text-4xl"></i>
          </div>
          <h2 class="text-3xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-tighter">Your wishlist is empty</h2>
          <p class="text-gray-500 mb-12 max-w-sm mx-auto italic">Looks like you haven't discovered your next signature scent yet. Explore our curated collection.</p>
          <a href="/shop" class="inline-block bg-luxury-black text-white px-12 py-5 rounded-full font-bold text-xs uppercase tracking-[0.3em] hover:bg-gold-600 transition shadow-2xl hover:-translate-y-1">
            Start Discovering
          </a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("wishlist-container");
  const notyf = new Notyf({
    duration: 3000,
    position: { x: 'right', y: 'bottom' },
    types: [
      { type: 'success', background: '#d4af37', icon: false },
      { type: 'error', background: '#121212', icon: false }
    ]
  });

  container.addEventListener("click", async (e) => {
    const card = e.target.closest(".wishlist-item");
    if (!card) return;
    const id = card.dataset.id;

    // Add To Cart Logic
    if (e.target.closest(".add-cart-btn")) {
      const btn = e.target.closest(".add-cart-btn");
      const originalContent = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i>';

      try {
        const res = await fetch(`/wishlist/api/addToCart/${id}`, { method: "POST" });
        const data = await res.json();
        if (data.success) {
          notyf.success(data.message);
          card.classList.add('scale-90', 'opacity-0');
          setTimeout(() => {
            card.remove();
            checkEmpty();
          }, 500);
        } else {
          notyf.error(data.message);
          btn.disabled = false;
          btn.innerHTML = originalContent;
        }
      } catch (err) {
        notyf.error("Connection error. Try again.");
        btn.disabled = false;
        btn.innerHTML = originalContent;
      }
    }

    // Remove Logic
    if (e.target.closest(".remove-btn")) {
      const btn = e.target.closest(".remove-btn");
      btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin text-xs"></i>';
      
      try {
        const res = await fetch(`/wishlist/api/remove/${id}`, { method: "DELETE" });
        const data = await res.json();
        if (data.status) {
          notyf.success(data.message);
          card.classList.add('scale-90', 'opacity-0');
          setTimeout(() => {
            card.remove();
            checkEmpty();
          }, 500);
        } else {
          notyf.error(data.message);
          btn.innerHTML = '<i class="fa-solid fa-heart-crack text-sm"></i>';
        }
      } catch (error) {
        notyf.error("Connection error.");
        btn.innerHTML = '<i class="fa-solid fa-heart-crack text-sm"></i>';
      }
    }
  });

  function checkEmpty() {
    if (!container.querySelector(".wishlist-item")) {
      container.innerHTML = `
        <div class="col-span-full py-32 text-center">
          <div class="w-24 h-24 bg-luxury-cream rounded-full flex items-center justify-center mx-auto mb-8 text-gold-200 shadow-inner">
            <i class="fa-solid fa-heart text-4xl"></i>
          </div>
          <h2 class="text-3xl font-serif font-bold text-luxury-black mb-4 uppercase tracking-tighter">Your wishlist is empty</h2>
          <p class="text-gray-500 mb-12 max-w-sm mx-auto italic">Looks like you haven't discovered your next signature scent yet. Explore our curated collection.</p>
          <a href="/shop" class="inline-block bg-luxury-black text-white px-12 py-5 rounded-full font-bold text-xs uppercase tracking-[0.3em] hover:bg-gold-600 transition shadow-2xl hover:-translate-y-1">
            Start Discovering
          </a>
        </div>`;
    }
  }
});
</script>

<%- include("../partials/user/footer.ejs") %>
