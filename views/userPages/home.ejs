<%- include("../partials/user/header.ejs") %>

<main class="bg-luxury-cream dark:bg-luxury-black min-h-screen transition-colors duration-300">
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-center">
      <!-- Left Image -->
      <div class="hidden lg:block animate-fade-in">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
          <img src="/images/hero-1.avif" alt="Luxury Scent" class="w-full h-full object-cover transform hover:scale-105 transition duration-1000" />
        </div>
      </div>

      <!-- Center Text -->
      <div class="text-center px-4">
        <h6 class="text-gold-600 font-bold tracking-[0.3em] uppercase text-[10px] mb-4 animate-slide-up">Established 2024</h6>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-luxury-black dark:text-white mb-6 leading-tight animate-slide-up" style="animation-delay: 100ms">
          The Essence of <br /> <span class="italic text-gold-400">Elegance</span>
        </h1>
        <p class="text-gray-500 text-sm md:text-base leading-relaxed mb-10 max-w-sm mx-auto animate-slide-up" style="animation-delay: 200ms">
          Discover fragrances that whisper luxury and linger with unforgettable charm. A scent crafted not just to wear, but to define your presence.
        </p>
        <div class="animate-slide-up" style="animation-delay: 300ms">
          <a href="/shop" class="inline-block bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-10 py-4 rounded-full font-bold text-sm tracking-widest uppercase hover:bg-gold-500 dark:hover:bg-gold-600 transition duration-300 shadow-xl">
            Shop Collection
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="hidden lg:block animate-fade-in" style="animation-delay: 400ms">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
          <img src="/images/hero-2.avif" alt="Premium Bottle" class="w-full h-full object-cover transform hover:scale-105 transition duration-1000" />
        </div>
      </div>
    </div>

    <!-- Mobile Hero Images (Grid) -->
    <div class="grid grid-cols-2 gap-4 mt-12 lg:hidden">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-lg animate-fade-in">
        <img src="/images/hero-1.avif" alt="Luxury Scent" class="w-full h-full object-cover" />
      </div>
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-lg animate-fade-in" style="animation-delay: 100ms">
        <img src="/images/hero-2.avif" alt="Premium Bottle" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-24 bg-white dark:bg-luxury-charcoal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h6 class="text-gold-600 dark:text-gold-400 font-bold tracking-widest uppercase text-xs mb-3">Explore Families</h6>
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-luxury-black dark:text-white mb-16">Fragrance Collections</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% categories.forEach(category => { %>
          <%- include("../partials/user/categoryCard.ejs", { category: category }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="py-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16">
        <div>
          <h6 class="text-gold-600 dark:text-gold-400 font-bold tracking-widest uppercase text-xs mb-3">Curated Selection</h6>
          <h2 class="text-4xl md:text-5xl font-serif font-bold text-luxury-black dark:text-white">Featured Scents</h2>
        </div>
        <a href="/shop" class="text-luxury-black dark:text-white font-bold text-sm tracking-widest uppercase border-b-2 border-gold-400 pb-1 hover:text-gold-600 dark:hover:text-gold-400 transition mt-6 md:mt-0">
          View All Fragrances
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-12">
        <% products.slice(0, 8).forEach(product => { %>
          <%- include("../partials/user/productCard.ejs", { product: product }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Brand Experience Section -->
  <section class="py-24 bg-luxury-black text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gold-600/5 -skew-x-12 transform translate-x-1/2"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
        <div class="text-center group">
          <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-8 group-hover:bg-gold-500/10 transition duration-500">
            <i class="fa-solid fa-droplet text-gold-400 text-3xl group-hover:scale-110 transition duration-500"></i>
          </div>
          <h4 class="font-serif text-2xl font-bold mb-4">Pure Essence</h4>
          <p class="text-gray-400 text-sm leading-relaxed max-w-xs mx-auto">
            Every bottle contains 100% authentic oils sourced from the finest fragrance houses.
          </p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-8 group-hover:bg-gold-500/10 transition duration-500">
            <i class="fa-solid fa-feather-pointed text-gold-400 text-3xl group-hover:scale-110 transition duration-500"></i>
          </div>
          <h4 class="font-serif text-2xl font-bold mb-4">Long Lasting</h4>
          <p class="text-gray-400 text-sm leading-relaxed max-w-xs mx-auto">
            Our extraits de parfum are formulated for exceptional projection and 24-hour longevity.
          </p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-8 group-hover:bg-gold-500/10 transition duration-500">
            <i class="fa-solid fa-shield-halved text-gold-400 text-3xl group-hover:scale-110 transition duration-500"></i>
          </div>
          <h4 class="font-serif text-2xl font-bold mb-4">Guaranteed</h4>
          <p class="text-gray-400 text-sm leading-relaxed max-w-xs mx-auto">
            Experience risk-free luxury with our 30-day return policy and authenticity guarantee.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("../partials/user/footer.ejs") %>

