<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VENICARA | Luxury Fragrances</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind Output -->
  <link rel="stylesheet" href="/css/output.css" />
  
  <!-- Notyf CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/f45c5ea548.js" crossorigin="anonymous"></script>

  <!-- Notyf JS -->
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>

  <!-- Custom JS -->
  <script defer src="/js/userHeader.js"></script>
  <script defer src="/js/toast.js"></script>

  <style>
    .dark .glass-header {
      background: rgba(10, 10, 10, 0.8);
      border-color: rgba(255, 255, 255, 0.1);
    }
  </style>

  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="flex flex-col min-h-screen bg-luxury-cream dark:bg-luxury-black text-luxury-black dark:text-luxury-white font-sans transition-colors duration-300">

  <header id="landing-header" class="sticky top-0 z-50 glass-header border-b border-gray-100 dark:border-white/10 transition-all duration-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="landing-inner" class="flex justify-between items-center h-24 transition-all duration-500">
        
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <a href="/" class="block">
            <img class="h-10 w-auto" src="/images/logo.avif" alt="VENICARA" />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex space-x-10">
          <a href="/" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">HOME</a>
          <a href="/shop" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">SHOP</a>
          <a href="/about" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">OUR STORY</a>
          <a href="/contact" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">CONTACT</a>
        </nav>

        <!-- Auth Buttons -->
        <div class="flex items-center space-x-6">
          <a href="/auth/login" class="text-sm font-semibold hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition hidden sm:inline-block">LOG IN</a>
          <a href="/auth/signup" class="bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-6 py-2 rounded-full text-sm font-bold hover:bg-gold-600 transition shadow-lg hidden sm:inline-block">SIGN UP</a>
          
          <!-- Theme Toggle -->
          <button id="theme-toggle" class="text-gray-700 dark:text-gray-300 hover:text-gold-600 dark:hover:text-gold-400 transition p-2 rounded-full hover:bg-gray-100 dark:hover:bg-white/5" title="Toggle Theme">
            <i class="fa-solid fa-moon dark:hidden text-xl"></i>
            <i class="fa-solid fa-sun hidden dark:block text-xl"></i>
          </button>

          <!-- Mobile Toggle -->
          <button id="landing-mobile-btn" class="md:hidden text-gray-700 dark:text-gray-300 hover:text-gold-600 p-2" aria-label="Toggle menu">
            <i class="fa-solid fa-bars text-xl" id="landing-mobile-icon"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="landing-mobile-menu" class="hidden md:hidden border-t border-gray-100 dark:border-white/10 bg-white/95 dark:bg-luxury-black/95 backdrop-blur-md px-6 py-6 transition-all duration-300">
      <nav class="flex flex-col space-y-4 text-sm font-semibold tracking-widest uppercase">
        <a href="/" class="py-2 hover:text-gold-600 dark:text-gray-200 border-b border-gray-50 dark:border-white/5">Home</a>
        <a href="/shop" class="py-2 hover:text-gold-600 dark:text-gray-200 border-b border-gray-50 dark:border-white/5">Shop Collection</a>
        <a href="/about" class="py-2 hover:text-gold-600 dark:text-gray-200 border-b border-gray-50 dark:border-white/5">Our Story</a>
        <a href="/contact" class="py-2 hover:text-gold-600 dark:text-gray-200 border-b border-gray-50 dark:border-white/5">Contact Concierge</a>
        <div class="pt-4 flex flex-col space-y-3">
          <a href="/auth/login" class="text-center py-3 rounded-full border border-gray-300 dark:border-white/20 text-xs font-bold tracking-widest">LOG IN</a>
          <a href="/auth/signup" class="text-center py-3 rounded-full bg-gold-500 text-black text-xs font-bold tracking-widest">SIGN UP</a>
        </div>
      </nav>
    </div>

    <!-- Flash Messages Container for toast.js -->
    <% if (messages.success && messages.success.length > 0) { %>
      <span id="flash-success" data-message="<%= messages.success[0] %>" hidden></span>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
      <span id="flash-error" data-message="<%= messages.error[0] %>" hidden></span>
    <% } %>
  </header>

  <script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    // Mobile menu toggle
    const landingMobileBtn = document.getElementById('landing-mobile-btn');
    const landingMobileMenu = document.getElementById('landing-mobile-menu');
    const landingMobileIcon = document.getElementById('landing-mobile-icon');
    landingMobileBtn?.addEventListener('click', () => {
      const isHidden = landingMobileMenu.classList.contains('hidden');
      if (isHidden) {
        landingMobileMenu.classList.remove('hidden');
        landingMobileIcon.classList.replace('fa-bars', 'fa-xmark');
      } else {
        landingMobileMenu.classList.add('hidden');
        landingMobileIcon.classList.replace('fa-xmark', 'fa-bars');
      }
    });

    // Landing scroll effect
    window.addEventListener('scroll', () => {
      const header = document.getElementById('landing-header');
      const inner = document.getElementById('landing-inner');
      if (window.scrollY > 50) {
        inner.classList.replace('h-24', 'h-16');
        header.classList.add('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
      } else {
        inner.classList.replace('h-16', 'h-24');
        header.classList.remove('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
      }
    });
  </script>

