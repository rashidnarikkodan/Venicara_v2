<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VENICARA | Luxury Fragrances</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind Output -->
  <link rel="stylesheet" href="/css/output.css" />
  
  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/f45c5ea548.js" crossorigin="anonymous"></script>

  <style>
    .dark .glass-header {
      background: rgba(10, 10, 10, 0.8);
      border-color: rgba(255, 255, 255, 0.1);
    }
  </style>

  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="flex flex-col min-h-screen bg-luxury-cream dark:bg-luxury-black text-luxury-black dark:text-luxury-white font-sans transition-colors duration-300">

  <header id="landing-header" class="sticky top-0 z-50 glass-header border-b border-gray-100 dark:border-white/10 transition-all duration-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="landing-inner" class="flex justify-between items-center h-24 transition-all duration-500">
        
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <a href="/" class="block">
            <img class="h-10 w-auto" src="/images/logo.avif" alt="VENICARA" />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex space-x-10">
          <a href="/" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">HOME</a>
          <a href="/shop" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">SHOP</a>
        </nav>

        <!-- Auth Buttons -->
        <div class="flex items-center space-x-6">
          <a href="/auth/login" class="text-sm font-semibold hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition">LOG IN</a>
          <a href="/auth/signup" class="bg-luxury-black dark:bg-gold-500 text-white dark:text-luxury-black px-6 py-2 rounded-full text-sm font-bold hover:bg-gold-600 transition shadow-lg">SIGN UP</a>
          
          <!-- Theme Toggle -->
          <button id="theme-toggle" class="text-gray-700 dark:text-gray-300 hover:text-gold-600 dark:hover:text-gold-400 transition p-2 rounded-full hover:bg-gray-100 dark:hover:bg-white/5" title="Toggle Theme">
            <i class="fa-solid fa-moon dark:hidden text-xl"></i>
            <i class="fa-solid fa-sun hidden dark:block text-xl"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Flash Messages Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 absolute w-full left-0">
      <div id="successBox" class="flex justify-center mt-2">
        <% if (messages.success.length > 0) { %>
          <div class="bg-green-50 border border-green-200 text-green-800 px-6 py-2 rounded-lg shadow-sm animate-fade-in-down">
            <%= messages.success[0] %>
          </div>
        <% } %>
      </div>

      <div id="errorBox" class="flex justify-center mt-2">
        <% if (messages.error.length > 0) { %>
          <div id="headerError" class="bg-red-50 border border-red-200 text-red-800 px-6 py-2 rounded-lg shadow-sm animate-fade-in-down">
            <%= messages.error[0] %>
          </div>
        <% } %>
      </div>
    </div>
  </header>

  <script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    // Landing scroll effect
    window.addEventListener('scroll', () => {
      const header = document.getElementById('landing-header');
      const inner = document.getElementById('landing-inner');
      if (window.scrollY > 50) {
        inner.classList.replace('h-24', 'h-16');
        header.classList.add('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
      } else {
        inner.classList.replace('h-16', 'h-24');
        header.classList.remove('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
      }
    });
  </script>

