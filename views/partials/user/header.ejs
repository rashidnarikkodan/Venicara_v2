<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VENICARA | Luxury Fragrances</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind Output -->
  <link rel="stylesheet" href="/css/output.css" />
  
  <!-- Notyf CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/f45c5ea548.js" crossorigin="anonymous"></script>

  <!-- Notyf JS -->
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>

  <!-- Custom JS -->
  <script defer src="/js/userHeader.js"></script>

  <style>
    .glass-header {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
    }
    .dark .glass-header {
      background: rgba(10, 10, 10, 0.8);
      border-color: rgba(255, 255, 255, 0.1);
    }
  </style>

  <script>
    // Essential script to prevent FOUC (Flash of Unstyled Content)
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="flex flex-col min-h-screen bg-luxury-cream dark:bg-luxury-black text-luxury-black dark:text-luxury-white font-sans transition-colors duration-300">

  <header id="main-header" class="sticky top-0 z-50 glass-header border-b border-gray-100 dark:border-white/10 transition-all duration-500">
    <% 
      const searchVal = typeof search !== 'undefined' ? search : '';
      const selectedCategoryVal = typeof selectedCategory !== 'undefined' ? selectedCategory : '';
      const sortVal = typeof sort !== 'undefined' ? sort : '';
      const minVal = typeof minPrice !== 'undefined' ? minPrice : '';
      const maxVal = typeof maxPrice !== 'undefined' ? maxPrice : '';
    %>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="header-inner" class="flex justify-between items-center h-24 transition-all duration-500">
        
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <a href="/home" class="block">
            <img class="h-10 w-auto" src="/images/logo.avif" alt="VENICARA" />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex space-x-10">
          <a href="/home" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">HOME</a>
          <a href="/shop" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">SHOP</a>
          <a href="/about" class="text-sm font-semibold tracking-widest hover:text-gold-600 dark:text-gray-300 dark:hover:text-gold-400 transition duration-200">OUR STORY</a>
        </nav>

        <!-- Right Icons / Search -->
        <div class="flex items-center space-x-6">
          
          <!-- Search Form (Desktop) -->
          <div class="hidden lg:block relative">
            <form action="/shop" id="search-form" class="relative">
              <input
                type="text"
                name="search"
                id="inputSearch"
                class="w-64 pl-4 pr-10 py-2 rounded-full border border-gray-200 dark:border-white/10 bg-white dark:bg-luxury-charcoal focus:border-gold-400 focus:ring-1 focus:ring-gold-400 outline-none transition-all text-sm dark:text-white"
                placeholder="Search fragrances..."
                value="<%= searchVal %>"
              />
              <% if (selectedCategoryVal) { %>
                <input type="hidden" name="category" value="<%= selectedCategoryVal %>" />
              <% } %>
              <% if (sortVal) { %>
                <input type="hidden" name="sort" value="<%= sortVal %>" />
              <% } %>
              <% if (minVal) { %>
                <input type="hidden" name="minPrice" value="<%= minVal %>" />
              <% } %>
              <% if (maxVal) { %>
                <input type="hidden" name="maxPrice" value="<%= maxVal %>" />
              <% } %>

              <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gold-600 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </form>
          </div>

          <!-- Icons -->
          <div class="flex items-center space-x-5">
            <a href="/wishlist" class="text-gray-700 hover:text-gold-600 transition relative group" title="Wishlist">
              <i class="fa-regular fa-heart text-xl"></i>
              <span class="absolute -top-1 -right-1 flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-gold-500"></span>
              </span>
            </a>

            <a href="/cart" class="text-gray-700 hover:text-gold-600 transition relative" title="Cart">
              <i class="fa-solid fa-cart-shopping text-xl"></i>
              <div class="absolute -top-2 -right-2 bg-luxury-black text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[18px] text-center" id="cart-count">0</div>
            </a>

            <a href="/profile" class="text-gray-700 dark:text-gray-300 hover:text-gold-600 dark:hover:text-gold-400 transition" title="Profile">
              <i class="fa-regular fa-circle-user text-xl"></i>
            </a>

            <!-- Theme Toggle -->
            <button id="theme-toggle" class="text-gray-700 dark:text-gray-300 hover:text-gold-600 dark:hover:text-gold-400 transition p-2 rounded-full hover:bg-gray-100 dark:hover:bg-white/5" title="Toggle Theme">
              <i class="fa-solid fa-moon dark:hidden text-xl"></i>
              <i class="fa-solid fa-sun hidden dark:block text-xl"></i>
            </button>

            <!-- Mobile Menu Button (Placeholder) -->
            <button class="md:hidden text-gray-700">
              <i class="fa-solid fa-bars text-xl"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Flash Messages Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 absolute w-full left-0">
      <div id="successBox" class="flex justify-center mt-2">
        <% if (messages.success.length > 0) { %>
          <div class="bg-green-50 border border-green-200 text-green-800 px-6 py-2 rounded-lg shadow-sm animate-fade-in-down">
            <%= messages.success[0] %>
          </div>
        <% } %>
      </div>

      <div id="errorBox" class="flex justify-center mt-2">
        <% if (messages.error.length > 0) { %>
          <div id="headerError" class="bg-red-50 border border-red-200 text-red-800 px-6 py-2 rounded-lg shadow-sm animate-fade-in-down">
            <%= messages.error[0] %>
          </div>
        <% } %>
      </div>
    </div>

    <script>
      async function updateCartCount() {
        try {
          const res = await fetch("/api/cart/count");
          const data = await res.json();
          document.getElementById("cart-count").textContent = data.count || 0;
        } catch (e) {
          console.error("Failed to fetch cart count:", e);
        }
      }
      updateCartCount();

      // Theme toggle logic
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });

      // Optimized header scroll effect
      window.addEventListener('scroll', () => {
        const header = document.getElementById('main-header');
        const inner = document.getElementById('header-inner');
        if (window.scrollY > 50) {
          inner.classList.replace('h-24', 'h-16');
          header.classList.add('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
        } else {
          inner.classList.replace('h-16', 'h-24');
          header.classList.remove('shadow-xl', 'bg-white/95', 'dark:bg-luxury-black/95');
        }
      });
    </script>
  </header>

