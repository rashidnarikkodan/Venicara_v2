<!-- Account Sidebar -->
<aside class="hidden lg:block w-72 flex-shrink-0">
  <div class="sticky top-24 bg-white dark:bg-luxury-charcoal rounded-3xl border border-gray-100 dark:border-white/5 shadow-sm overflow-hidden">
    <!-- User Profile Header -->
    <div class="p-8 bg-luxury-cream dark:bg-luxury-black/40 border-b border-gray-100 dark:border-white/5">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-luxury-black dark:bg-gold-500 rounded-2xl flex items-center justify-center text-gold-400 dark:text-luxury-black text-2xl font-serif font-bold shadow-lg">
          <%= user.name.charAt(0) %>
        </div>
        <div class="overflow-hidden">
          <p class="text-[10px] text-gold-600 dark:text-gold-400 font-bold uppercase tracking-[0.2em] mb-1">Membership</p>
          <h3 class="text-luxury-black dark:text-white font-bold truncate tracking-tight uppercase text-sm"><%= user.name %></h3>
        </div>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="p-4">
      <ul class="space-y-1">
        <li>
          <a href="/profile" class="flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-gray-50 dark:hover:bg-white/5">
            <i class="fa-regular fa-user text-lg text-gray-400 group-hover:text-gold-600 dark:group-hover:text-gold-400"></i>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 group-hover:text-luxury-black dark:group-hover:text-white">Personal Info</span>
          </a>
        </li>
        <li>
          <a href="/orders" class="flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-gray-50 dark:hover:bg-white/5">
            <i class="fa-solid fa-box text-lg text-gray-400 group-hover:text-gold-600 dark:group-hover:text-gold-400"></i>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 group-hover:text-luxury-black dark:group-hover:text-white">My Orders</span>
          </a>
        </li>
        <li>
          <a href="/wallet" class="flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-gray-50 dark:hover:bg-white/5">
            <i class="fa-solid fa-wallet text-lg text-gray-400 group-hover:text-gold-600 dark:group-hover:text-gold-400"></i>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 group-hover:text-luxury-black dark:group-hover:text-white">My Wallet</span>
          </a>
        </li>
        <li>
          <a href="/address" class="flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-gray-50 dark:hover:bg-white/5">
            <i class="fa-solid fa-map-pin text-lg text-gray-400 group-hover:text-gold-600 dark:group-hover:text-gold-400"></i>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 group-hover:text-luxury-black dark:group-hover:text-white">Manage Addresses</span>
          </a>
        </li>
        <li>
          <a href="/referEarn" class="flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-gray-50 dark:hover:bg-white/5">
            <i class="fa-solid fa-gift text-lg text-gray-400 group-hover:text-gold-600 dark:group-hover:text-gold-400"></i>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 group-hover:text-luxury-black dark:group-hover:text-white">Refer & Earn</span>
          </a>
        </li>
        <li class="pt-4 mt-4 border-t border-gray-50 dark:border-white/5">
          <button onclick="showLogoutModal()" class="w-full flex items-center space-x-4 px-6 py-4 rounded-2xl transition duration-300 group hover:bg-red-50 dark:hover:bg-red-500/10 text-red-400">
            <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
            <span class="text-xs font-bold uppercase tracking-widest">Sign Out</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</aside>

<!-- Mobile Account Menu Trigger -->
<div class="lg:hidden mb-8">
  <button id="openMobileNav" class="flex items-center justify-between w-full bg-white dark:bg-luxury-charcoal px-6 py-4 rounded-2xl border border-gray-100 dark:border-white/5 shadow-sm">
    <div class="flex items-center space-x-4">
      <div class="w-10 h-10 bg-luxury-black dark:bg-gold-500 rounded-xl flex items-center justify-center text-gold-400 dark:text-luxury-black font-bold">
        <%= user.name.charAt(0) %>
      </div>
      <span class="text-sm font-bold uppercase tracking-widest dark:text-white">Account Menu</span>
    </div>
    <i class="fa-solid fa-chevron-down text-gray-400"></i>
  </button>
</div>

<!-- Mobile Navigation Drawer -->
<div id="mobileAccountNav" class="fixed inset-0 z-[100] hidden overflow-hidden">
  <div id="mobileNavOverlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
  <div id="mobileNavContent" class="absolute bottom-0 inset-x-0 bg-white dark:bg-luxury-charcoal rounded-t-[3rem] p-8 translate-y-full transition-transform duration-500">
    <div class="w-12 h-1 bg-gray-100 dark:bg-white/10 rounded-full mx-auto mb-8"></div>
    <h2 class="text-xl font-serif font-bold text-luxury-black dark:text-white mb-8 text-center uppercase tracking-tighter">Your Account</h2>
    <ul class="space-y-2 mb-10">
      <li><a href="/profile" class="flex items-center space-x-4 px-6 py-4 rounded-2xl bg-gray-50 dark:bg-luxury-black text-sm font-bold uppercase tracking-widest dark:text-white"><i class="fa-regular fa-user text-gold-600 dark:text-gold-400"></i><span>Personal Info</span></a></li>
      <li><a href="/orders" class="flex items-center space-x-4 px-6 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-luxury-black text-sm font-bold uppercase tracking-widest transition dark:text-white"><i class="fa-solid fa-box text-gold-600 dark:text-gold-400"></i><span>My Orders</span></a></li>
      <li><a href="/wallet" class="flex items-center space-x-4 px-6 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-luxury-black text-sm font-bold uppercase tracking-widest transition dark:text-white"><i class="fa-solid fa-wallet text-gold-600 dark:text-gold-400"></i><span>Wallet</span></a></li>
      <li><a href="/address" class="flex items-center space-x-4 px-6 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-luxury-black text-sm font-bold uppercase tracking-widest transition dark:text-white"><i class="fa-solid fa-map-pin text-gold-600 dark:text-gold-400"></i><span>Addresses</span></a></li>
      <li><a href="/referEarn" class="flex items-center space-x-4 px-6 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-luxury-black text-sm font-bold uppercase tracking-widest transition dark:text-white"><i class="fa-solid fa-gift text-gold-600 dark:text-gold-400"></i><span>Refer & Earn</span></a></li>
      <li class="pt-4"><button onclick="showLogoutModal()" class="w-full flex items-center space-x-4 px-6 py-4 rounded-2xl text-red-500 text-sm font-bold uppercase tracking-widest"><i class="fa-solid fa-arrow-right-from-bracket"></i><span>Sign Out</span></button></li>
    </ul>
  </div>
</div>

<!-- Logout Confirmation Modal -->
<div id="logoutModal" class="fixed inset-0 z-[110] hidden flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative bg-white dark:bg-luxury-charcoal rounded-3xl p-10 max-w-sm w-full shadow-2xl text-center transform transition-all duration-300 scale-95 opacity-0" id="logoutModalContent">
    <div class="w-16 h-16 bg-red-50 dark:bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-6 text-red-500">
      <i class="fa-solid fa-right-from-bracket text-2xl"></i>
    </div>
    <h2 class="text-2xl font-serif font-bold text-luxury-black dark:text-white mb-2">Sign Out?</h2>
    <p class="text-gray-500 dark:text-gray-400 text-sm mb-10 leading-relaxed">Are you sure you want to log out of your Venicara account? We'll be here when you're ready for your next scent.</p>
    <div class="flex gap-4">
      <button onclick="hideLogoutModal()" class="flex-1 py-4 border-2 border-gray-100 dark:border-white/10 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-gray-50 dark:hover:bg-white/5 dark:text-gray-300 transition">Stay</button>
      <form action="/auth/logout" method="post" class="flex-1">
        <button type="submit" class="w-full py-4 bg-luxury-black dark:bg-red-500 text-white rounded-full font-bold text-xs uppercase tracking-widest hover:bg-red-500 dark:hover:bg-red-600 transition shadow-lg">Logout</button>
      </form>
    </div>
  </div>
</div>

<script>
  // Mobile Nav Drawer Logic
  const openNavBtn = document.getElementById('openMobileNav');
  const mobileNav = document.getElementById('mobileAccountNav');
  const navContent = document.getElementById('mobileNavContent');
  const navOverlay = document.getElementById('mobileNavOverlay');

  function openNav() {
    mobileNav.classList.remove('hidden');
    setTimeout(() => {
      navOverlay.classList.remove('opacity-0');
      navContent.classList.remove('translate-y-full');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeNav() {
    navOverlay.classList.add('opacity-0');
    navContent.classList.add('translate-y-full');
    setTimeout(() => {
      mobileNav.classList.add('hidden');
      document.body.style.overflow = '';
    }, 500);
  }

  openNavBtn?.addEventListener('click', openNav);
  navOverlay?.addEventListener('click', closeNav);

  // Logout Modal Logic
  function showLogoutModal() {
    const modal = document.getElementById('logoutModal');
    const content = document.getElementById('logoutModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function hideLogoutModal() {
    const modal = document.getElementById('logoutModal');
    const content = document.getElementById('logoutModalContent');
    content.classList.add('scale-95', 'opacity-0');
    content.classList.remove('scale-100', 'opacity-100');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }
</script>

